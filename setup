#!/usr/bin/env bash
#
# setup - one-time bootstrap for the scripts in this repository.
#
# NOT the same thing as `system-setup setup`, which installs the system-setup
# symlink and puts sbin on PATH. This installs the prerequisites for BOTH
# tools and then runs each tool's own setup. It is never installed
# system-wide; run it from a checkout:
#
#     bash setup
#
# Spec: Fixes/2026-08-26/01-Description.md  (change 1)

set -euo pipefail

# Deliberately NOT setting IFS=$'\n\t' the way system-setup and git-utils do.
# That value exists there to make unquoted expansions safer, and it has been
# the root cause of six separate bugs in this repository. This script has no
# unquoted expansions to protect - the package list is an array - so the
# default IFS is both sufficient and one less trap.

readonly E_PRECHECK=1 E_IO=3

readonly -a PACKAGES=(
    git             # git-utils
    coreutils       # realpath - both
    util-linux      # sfdisk, blkid, findmnt - system-setup hdd
    jq              # both
    openssh-client  # ssh-keygen - git-utils
    sudo            # both
    yq              # system-setup file, YAML input
)

# The filesystem toolchains (xfsprogs, dosfstools, ntfs-3g) are deliberately
# NOT installed here. They are needed only by `system-setup hdd` with a
# specific --type, which pre-checks them and prints the exact apt line for the
# one filesystem actually requested. Installing all four on every host is
# noise for a dependency most hosts never use.

info() { printf '%s\n' "$*"; }
die()  { printf 'error: %s\n' "$*" >&2; exit "$1"; }

# Resolved before any directory change, so the sibling scripts are found
# relative to this file rather than to $PWD.
if command -v realpath >/dev/null 2>&1; then
    SELF="$(realpath "${BASH_SOURCE[0]}")"
else
    SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
fi
readonly SELF
REPO="$(dirname "$SELF")"
readonly REPO

for tool in git-utils system-setup; do
    [ -f "$REPO/$tool" ] || die "$E_PRECHECK" "$tool not found beside this script in $REPO"
done

# ---------------------------------------------------------------------------
# Privilege model
#
# apt needs root. Both sub-setups write ~/.bashrc and must therefore run as
# the INVOKING user - after `sudo bash setup` that is not root, and running
# them elevated would put the PATH and shortcuts blocks in /root/.bashrc where
# nobody would ever source them. `sudo -u <user> -H` is what drops back; -H is
# required, or HOME stays root's and the blocks land wrong anyway.
# ---------------------------------------------------------------------------
declare -a APT=() RUN_AS=()

if [ "$EUID" -eq 0 ]; then
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        RUN_AS=(sudo -u "$SUDO_USER" -H)
        info "running as root via sudo; the setup steps will run as '$SUDO_USER'"
    fi
else
    command -v sudo >/dev/null 2>&1 \
        || die "$E_PRECHECK" "not running as root and sudo is not available"
    APT=(sudo)
fi

# ---------------------------------------------------------------------------

info "installing prerequisites: ${PACKAGES[*]}"
export DEBIAN_FRONTEND=noninteractive
"${APT[@]}" apt-get update -y >/dev/null 2>&1 \
    || die "$E_IO" "apt-get update failed"
"${APT[@]}" apt-get install -y "${PACKAGES[@]}" >/dev/null 2>&1 \
    || die "$E_IO" "failed to install: ${PACKAGES[*]}"
info "prerequisites installed"

# run_setup <script> <label> -- run one tool's setup as the invoking user.
#
# The `-l` is load-bearing when dropping back through sudo. `sudo -u <user>`
# hands the child sudo's secure_path, which contains /usr/local/sbin - while
# the user's REAL login PATH does not. Without a login shell the sub-setup
# sees sbin already on PATH, concludes there is nothing to add, and skips the
# ~/.bashrc block the user's actual shell needs. The result is a silently
# half-working install: symlinks present, unreachable, and no block to fix it.
run_setup() {
    local script="$1" label="$2"
    info ""
    info "=== $label setup ==="
    if [ "${#RUN_AS[@]}" -gt 0 ]; then
        "${RUN_AS[@]}" bash -lc "bash $(printf '%q' "$script") setup" \
            || die "$E_IO" "'$label setup' failed"
    else
        # Already the right user: the current PATH is the one that matters.
        bash "$script" setup || die "$E_IO" "'$label setup' failed"
    fi
    return 0
}

run_setup "$REPO/git-utils" "git-utils"
run_setup "$REPO/system-setup" "system-setup"

info ""
info "bootstrap complete"
info "note: already-open shells need 'source ~/.bashrc' to pick up the changes"
