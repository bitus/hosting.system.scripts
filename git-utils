#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# ---------------------------------------------------------------------------
# 2. Constants
# ---------------------------------------------------------------------------

# shellcheck disable=SC2034  # E_OK documents the full exit-code space; success needs no explicit exit
readonly E_OK=0 E_PRECHECK=1 E_ARGS=2 E_IO=3 E_EXISTS=4 E_NOTFOUND=5
# shellcheck disable=SC2034  # E_GITFOLDER/E_MISMATCH/E_CMDOUTPUT land with the commands that raise them
readonly E_GITFOLDER=6 E_MISMATCH=8 E_CMDOUTPUT=10 E_DBFORMAT=90
# shellcheck disable=SC2034  # the docker codes land with the commands added by fix 50-04
readonly E_NOCOMPOSE=14 E_NOTRUNNING=16 E_IMAGE=18 E_NOUPDATE=22

# What timeout(1) returns when it kills the command it wrapped. Mapped to a
# domain code by every caller -- a bare 124 tells the user nothing.
# shellcheck disable=SC2034
readonly TIMEOUT_EXIT=124
# shellcheck disable=SC2034
readonly PULL_TIMEOUT_DEFAULT=300 STATUS_TIMEOUT_DEFAULT=60
readonly SCHEMA_VERSION="1.1"
readonly SCHEMA_REGEX='^[0-9]+(\.[0-9]+)?$'
readonly REPOS_FILE="$HOME/.repositories.json"
readonly LOCK_FILE="$HOME/.repositories.json.lock"
readonly SSH_DIR="$HOME/.ssh"
readonly SSH_CONFIG="$SSH_DIR/config"
readonly BASHRC="$HOME/.bashrc"
readonly DEFAULT_BRANCH_FALLBACK="main"
readonly CHARSET='A-Za-z0-9._-'
readonly LOCK_WAIT=10
readonly IMAGES_FILE_NAME=".images"
readonly COMPOSE_PROFILE_WILDCARD='*'

declare -A DEP_PACKAGE=(
    [git]="git"
    [realpath]="coreutils"
    [jq]="jq"
    [ssh-keygen]="openssh-client"
    [yq]="yq"
)

declare -a CLEANUP_TMPFILES=()
cleanup_tmpfiles() {
    local f
    for f in "${CLEANUP_TMPFILES[@]}"; do
        rm -f "$f"
    done
    return 0
}
trap cleanup_tmpfiles EXIT

# ---------------------------------------------------------------------------
# 3. Output helpers
# ---------------------------------------------------------------------------

info() { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }

die() {
    local code="$1"; shift
    printf 'error: %s\n' "$*" >&2
    exit "$code"
}

confirm() {
    local prompt="$1" reply
    if [ "${FORCE:-0}" = "1" ]; then
        return 0
    fi
    if [ ! -t 0 ]; then
        die "$E_ARGS" "confirmation required but stdin is not a TTY (use --force)"
    fi
    read -r -p "$prompt [Y/n] " reply || reply=""
    case "$reply" in
        [nN]*) return 1 ;;
        *) return 0 ;;
    esac
}

# ---------------------------------------------------------------------------
# 4. Status & render helpers
# ---------------------------------------------------------------------------

# status_obj <code> <status> [description] -- one check result, compact JSON.
#
# Statuses: Ok, Fixed, Warning, Skipped (all passing) and Failed.
status_obj() {
    jq -nc --argjson c "$1" --arg s "$2" --arg d "${3:-}" \
        '{code:$c, status:$s, description:$d}'
}

# status_failed <status_json> -- true when this check counts as a failure.
#
# Failure is decided by .status == "Failed", NOT by .code != 0: the `fields`
# check fails with code 90 while `Warning` passes with code 0, so the code is
# not a reliable predicate.
status_failed() {
    [ "$(jq -r '.status' <<< "$1")" = "Failed" ]
}

# Folds every status object anywhere in the structure into a plain string.
# The type guard comes first because has() errors on non-objects; recursion
# through map_values/map reaches status objects nested inside checks.locations
# and inside the repositories array without any special-casing.
#
# Empty description -> bare status, so a passing check reads "Ok".
# Non-empty         -> "<status> — <description>", so the default output never
#                      hides the reason a check failed.
readonly FOLD_FILTER='
def fold:
  if type == "object" then
    if (has("code") and has("status"))
    then (if (.description // "") == "" then .status
          else "\(.status) — \(.description)" end)
    else map_values(fold)
    end
  elif type == "array" then map(fold)
  else . end;
fold'

# Plain renderers. Each is a jq program emitting raw lines for `--output-format
# plain`.
readonly PLAIN_ID='.id'

readonly OUTPUT_FORMAT_DEFAULT="plain"
OUTPUT_FORMAT="$OUTPUT_FORMAT_DEFAULT"

# output_format_set <value> -- validate and assign, for the flag loops
output_format_set() {
    case "$1" in
        json|text|yaml|plain) OUTPUT_FORMAT="$1" ;;
        *) die "$E_ARGS" "invalid --output-format: '$1' (expected json, text, yaml or plain)" ;;
    esac
}

# render_output <json> [plain_filter] -- emit per $OUTPUT_FORMAT
#
# `plain` is the default format and means "line-oriented, easy for a pipe to
# consume". Only a few commands have a sensible line form; the rest pass no
# filter and `plain` falls through to `text`, so making it the default changed
# nothing for any command that existed before fix 50-04.
#
# plain_filter is a jq program emitting raw lines (jq -r).
render_output() {
    local json="$1" plain_filter="${2:-}"
    case "$OUTPUT_FORMAT" in
        json)  printf '%s' "$json" | jq . ;;
        plain)
            if [ -n "$plain_filter" ]; then
                printf '%s' "$json" | jq -r "$plain_filter"
            else
                printf '%s' "$json" | jq "$FOLD_FILTER" | yq -y .
            fi ;;
        text|yaml) printf '%s' "$json" | jq "$FOLD_FILTER" | yq -y . ;;
        *)         die "$E_ARGS" "invalid output format: '$OUTPUT_FORMAT'" ;;
    esac
}

# ---------------------------------------------------------------------------
# 5. File helpers
# ---------------------------------------------------------------------------

ensure_trailing_newline() {
    local file="$1"
    if [ -s "$file" ] && [ "$(tail -c1 "$file" | wc -l)" -eq 0 ]; then
        printf '\n' >> "$file"
    fi
}

atomic_write() {
    local file="$1" mode="$2" tmp
    tmp="$(mktemp "${file}.XXXXXX")"
    CLEANUP_TMPFILES+=("$tmp")
    cat > "$tmp"
    chmod "$mode" "$tmp"
    mv "$tmp" "$file"
}

block_marker_open() {
    local id="${1:-}"
    if [ -n "$id" ]; then
        printf '# >>> git-utils %s >>>' "$id"
    else
        printf '# >>> git-utils >>>'
    fi
}

block_marker_close() {
    local id="${1:-}"
    if [ -n "$id" ]; then
        printf '# <<< git-utils %s <<<' "$id"
    else
        printf '# <<< git-utils <<<'
    fi
}

# block_upsert <file> <sentinel_id> <content>
# <content> is the full block text, sentinel lines included.
block_upsert() {
    local file="$1" sentinel_id="$2" content="$3"
    local open close_marker tmp mode

    open="$(block_marker_open "$sentinel_id")"
    close_marker="$(block_marker_close "$sentinel_id")"

    if [ -e "$file" ]; then
        mode="$(stat -c '%a' "$file")"
    else
        : > "$file"
        mode="644"
    fi
    ensure_trailing_newline "$file"

    tmp="$(mktemp "${file}.XXXXXX")"
    CLEANUP_TMPFILES+=("$tmp")

    if grep -qF "$open" "$file"; then
        awk -v open="$open" -v close_marker="$close_marker" -v content="$content" '
            $0 == open { print content; skip=1; next }
            $0 == close_marker { skip=0; next }
            skip { next }
            { print }
        ' "$file" > "$tmp"
    else
        cat "$file" > "$tmp"
        printf '%s\n' "$content" >> "$tmp"
    fi

    chmod "$mode" "$tmp"
    mv "$tmp" "$file"
}

# block_delete <file> <sentinel_id>  -- silent no-op if the block is absent
block_delete() {
    local file="$1" sentinel_id="$2"
    local open close esc_open esc_close tmp mode

    [ -f "$file" ] || return 0

    open="$(block_marker_open "$sentinel_id")"
    close="$(block_marker_close "$sentinel_id")"
    esc_open="$(printf '%s' "$open" | sed 's/[.[\*^$/]/\\&/g')"
    esc_close="$(printf '%s' "$close" | sed 's/[.[\*^$/]/\\&/g')"

    mode="$(stat -c '%a' "$file")"
    tmp="$(mktemp "${file}.XXXXXX")"
    CLEANUP_TMPFILES+=("$tmp")

    sed "/^${esc_open}\$/,/^${esc_close}\$/d" "$file" > "$tmp" \
        || die "$E_IO" "failed to update $file"

    chmod "$mode" "$tmp"
    mv "$tmp" "$file"
}

# ---------------------------------------------------------------------------
# 6. Lock helpers
# ---------------------------------------------------------------------------

# store_lock_writable <fd> -- shared writability pre-check: `exec N>file`
# is a bash special builtin, and a failed bare-redirect exec TERMINATES THE
# WHOLE SHELL outright (this bypasses `||` entirely -- it's not a normal
# command failure). Checking writability first avoids ever attempting the
# risky exec when it would fail; a permission change in the narrow window
# between this check and the exec is an accepted, extremely unlikely race.
#
# NOTE: never attach `2>/dev/null` (or any redirect) to a *bare* `exec`
# statement below. Bash applies a bare exec's redirects to the current
# shell PERMANENTLY, not just to that one statement -- `exec 9>f 2>/dev/null`
# would silently discard this process's stderr (including every later
# warn()) for the rest of its run. This is exactly the bug that motivated
# this comment: it shipped once and silently ate every warning after the
# first store_lock call.
store_lock_writable() {
    if [ -e "$LOCK_FILE" ]; then
        [ -w "$LOCK_FILE" ]
    else
        [ -w "$(dirname "$LOCK_FILE")" ]
    fi
}

store_lock() {
    store_lock_writable || die "$E_IO" "cannot open lock file $LOCK_FILE"
    exec 9>"$LOCK_FILE" || die "$E_IO" "cannot open lock file $LOCK_FILE"
    flock -w "$LOCK_WAIT" 9 || die "$E_IO" "could not acquire lock on $LOCK_FILE (busy)"
}

store_unlock() {
    exec 9>&-
}

# store_lock_soft / store_unlock_soft -- like store_lock/store_unlock but
# return 1 instead of dying on failure to open or acquire the lock.
# Used only by images_write, whose failures must never affect exit code.
store_lock_soft() {
    store_lock_writable || return 1
    exec 9>"$LOCK_FILE" || return 1
    flock -w "$LOCK_WAIT" 9 2>/dev/null || { exec 9>&-; return 1; }
}

store_unlock_soft() {
    exec 9>&-
}

# ---------------------------------------------------------------------------
# 7. Pre-check helpers
# ---------------------------------------------------------------------------

require_cmds() {
    local missing=() cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    [ "${#missing[@]}" -eq 0 ] && return 0

    local missing_str="" pkgs=() seen="" pkg
    for cmd in "${missing[@]}"; do
        if [ -z "$missing_str" ]; then missing_str="$cmd"; else missing_str="$missing_str, $cmd"; fi
        pkg="${DEP_PACKAGE[$cmd]:-$cmd}"
        case " $seen " in
            *" $pkg "*) ;;
            *) pkgs+=("$pkg"); seen="$seen $pkg" ;;
        esac
    done
    local pkgs_str="" p
    for p in "${pkgs[@]}"; do
        if [ -z "$pkgs_str" ]; then pkgs_str="$p"; else pkgs_str="$pkgs_str $p"; fi
    done

    printf 'error: those commands not available: %s\n' "$missing_str" >&2
    printf 'please run "sudo apt install %s -y" to install\n' "$pkgs_str" >&2
    exit "$E_PRECHECK"
}

# `yq` is a global dependency, not scoped to the commands that format output:
# the sibling `system-setup` and `setup` scripts in this project already
# require it, so a host running git-utils has it anyway, and scoping it would
# buy complexity for no reachable benefit.
precheck_common() { require_cmds git realpath jq yq; }

# precheck_store_format -- the schema gate, for a store that exists.
precheck_store_format() {
    case "$(db_format_state)" in
        ok) ;;
        invalid) die "$E_IO" "$REPOS_FILE is not valid JSON" ;;
        newer)
            die "$E_DBFORMAT" \
                "$REPOS_FILE was written by a newer git-utils (schema $(db_schema_version)); this script understands $SCHEMA_VERSION"
            ;;
        badschema)
            die "$E_DBFORMAT" \
                "$REPOS_FILE has an invalid schema version; run 'git-utils validate' to inspect it"
            ;;
        old)
            die "$E_DBFORMAT" \
                "$REPOS_FILE is in an old format; run 'git-utils validate --fix' to convert it"
            ;;
    esac
}

# precheck_store -- for commands that read an existing store.
#
# NOTE: `validate` must NOT call this. Inspecting and repairing an unusable
# store is that command's entire purpose, so it calls db_format_state itself
# and reports the result instead of dying on it.
precheck_store() {
    [ -f "$REPOS_FILE" ] || die "$E_PRECHECK" "$REPOS_FILE not found; run 'git-utils repo add' first"
    precheck_store_format
}

# precheck_store_creatable -- for the commands that bring the FIRST record into
# existence (`repo add`, `folder adopt`) and call repos_init themselves. A
# missing store is fine; a store in an unusable format is not.
#
# Without the format gate here, `repo add` against an old flat store would
# write `.repositories[id]` alongside the existing root-level records and leave
# the file half in each layout.
precheck_store_creatable() {
    [ -f "$REPOS_FILE" ] || return 0
    precheck_store_format
}

# ---------------------------------------------------------------------------
# 8. Parsing layer
# ---------------------------------------------------------------------------

validate_part() {
    local value="$1" minlen="$2" label="$3"
    if [[ ! "$value" =~ ^[$CHARSET]+$ ]]; then
        die "$E_ARGS" "invalid $label: '$value'"
    fi
    if [ "${#value}" -lt "$minlen" ]; then
        die "$E_ARGS" "invalid $label: '$value' (minimum length $minlen)"
    fi
}

# parse_repo_name <value>  -- sets REPO_ORG, REPO_NAME, REPO_BRANCH
parse_repo_name() {
    local input="$1"
    local -a parts
    IFS='/' read -r -a parts <<< "$input"
    local n="${#parts[@]}"

    case "$n" in
        3)
            REPO_ORG="${parts[0]}"
            REPO_NAME="${parts[1]}"
            REPO_BRANCH="${parts[2]}"
            ;;
        2)
            REPO_ORG="${parts[0]}"
            REPO_NAME="${parts[1]}"
            REPO_BRANCH="${GH_DEFAULT_BRANCH:-$DEFAULT_BRANCH_FALLBACK}"
            ;;
        1)
            REPO_NAME="${parts[0]}"
            [ -n "${GH_DEFAULT_ORG:-}" ] || die "$E_ARGS" "no org given and GH_DEFAULT_ORG is not set"
            REPO_ORG="$GH_DEFAULT_ORG"
            REPO_BRANCH="${GH_DEFAULT_BRANCH:-$DEFAULT_BRANCH_FALLBACK}"
            ;;
        *)
            die "$E_ARGS" "invalid repo name: '$input'"
            ;;
    esac

    validate_part "$REPO_ORG" 3 "org"
    validate_part "$REPO_NAME" 3 "name"
    validate_part "$REPO_BRANCH" 1 "branch"
}

# resolve_repo_target <value> -- repo key or full name; NEVER a path.
#
# Fix 50-04 split the two address spaces: `repo` commands name a record,
# `folder` commands name a place on disk. The error points at the bridge
# rather than just refusing, because a user standing in a checkout has to be
# told what to type instead.
# shellcheck disable=SC2016  # the single quotes below are literal message
# text showing the user what to type; $value is inside double quotes and does
# expand
resolve_repo_target() {
    local value="${1:-}" hint="${2:-}"
    [ -n "$value" ] || die "$E_ARGS" "this command needs a repo key or full repo name"
    case "$value" in
        .|..|/*|./*|../*|~*)
            die "$E_ARGS" "repo commands take a repo key or full repo name, not a path${hint:+ -- for a folder, use: git-utils $hint '$value'} -- or bridge it: git-utils repo <cmd> \"\$(git-utils folder repo '$value')\"" ;;
    esac
    if [ -d "$value" ]; then
        die "$E_ARGS" "'$value' is a folder${hint:+ -- use: git-utils $hint '$value'} -- or bridge it: git-utils repo <cmd> \"\$(git-utils folder repo '$value')\""
    fi

    if [[ "$value" == */* ]]; then
        TARGET_KIND="fullname"
        parse_repo_name "$value"
        TARGET_VALUE="$value"
    else
        TARGET_KIND="key"
        validate_part "$value" 3 "key"
        TARGET_VALUE="$value"
    fi
}

# resolve_target [<value>]  -- sets TARGET_KIND (path|fullname|key), TARGET_VALUE
resolve_target() {
    local value="${1:-}" raw="${1:-}"
    [ -n "$raw" ] || raw="."

    case "$raw" in
        .|..|/*|./*|../*|~*)
            TARGET_KIND="path"
            TARGET_VALUE="$(realpath -m -- "$raw")"
            return
            ;;
    esac

    if [[ "$value" == */* ]]; then
        TARGET_KIND="fullname"
        parse_repo_name "$value"
        TARGET_VALUE="$value"
    else
        TARGET_KIND="key"
        validate_part "$value" 3 "key"
        TARGET_VALUE="$value"
    fi
}

# ---------------------------------------------------------------------------
# 9. Store layer -- db_* / repos_*
# ---------------------------------------------------------------------------

# db_schema_version [<file>] -- prints the raw .schema value, empty when absent
db_schema_version() {
    local file="${1:-$REPOS_FILE}"
    jq -r 'if type == "object" and has("schema") then (.schema | tostring) else "" end' \
        "$file" 2>/dev/null || printf ''
}

# db_format_state [<file>] -- prints one of: ok | old | badschema | invalid | newer
#
# Single source of truth for store-format classification. Two consumers with
# different reactions: precheck_store dies on the result, `validate` renders it
# as status objects. Writing the classification twice would let them drift.
#
# The optional <file> argument is what lets the conversion verify its own temp
# file with the same code that classifies the real store; no caller passes it
# until that lands.
# shellcheck disable=SC2120
db_format_state() {
    local file="${1:-$REPOS_FILE}" ver major known_major

    jq empty "$file" >/dev/null 2>&1 || { printf 'invalid\n'; return 0; }

    if ! jq -e 'type == "object" and has("schema") and has("repositories")' \
            "$file" >/dev/null 2>&1; then
        printf 'old\n'
        return 0
    fi

    # Has the new shape but an unusable version marker. NOT 'old': converting
    # would wrap the document a second time, giving
    # {schema, repositories: {schema, repositories}}. Report it instead --
    # guessing a version for data of unknown vintage is worse than saying so.
    ver="$(db_schema_version "$file")"
    if [ -z "$ver" ] || [[ ! "$ver" =~ $SCHEMA_REGEX ]]; then
        printf 'badschema\n'
        return 0
    fi

    major="${ver%%.*}"
    known_major="${SCHEMA_VERSION%%.*}"
    if [ "$major" -gt "$known_major" ] 2>/dev/null; then
        printf 'newer\n'
        return 0
    fi

    printf 'ok\n'
}

# backup_path -- a timestamped name that never collides.
#
# Backups are tied to conversions, not to runs, and a conversion happens at
# most once per store, so these do not accumulate. The collision loop covers
# two conversions inside the same second; overwriting a backup is never
# acceptable, since it could be the only clean copy left.
backup_path() {
    local ts p n=1
    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    p="${REPOS_FILE}.${ts}.bak"
    while [ -e "$p" ]; do
        p="${REPOS_FILE}.${ts}-${n}.bak"
        n=$((n + 1))
    done
    printf '%s' "$p"
}

# db_convert_with_backup -- old flat layout -> schema 1.1. Prints the backup
# path on success.
#
# Order matters: build, VERIFY, back up, then move. A conversion that fails
# verification leaves the original byte-for-byte intact, writes no backup, and
# leaves no temp file behind -- so there is no damaged-store state for a later
# run to find, and no residue from a failed attempt.
db_convert_with_backup() {
    local tmp bak
    tmp="$(mktemp "${REPOS_FILE}.XXXXXX")"
    CLEANUP_TMPFILES+=("$tmp")

    # A store that already carries a `repositories` object only lost its
    # version marker -- stamp it. Anything else is the flat pre-1.1 layout and
    # gets wrapped. Wrapping the former would nest it inside itself.
    jq --arg v "$SCHEMA_VERSION" \
        'if (type == "object" and has("repositories") and (.repositories | type == "object"))
         then .schema = $v
         else {schema: $v, repositories: .} end' \
        "$REPOS_FILE" > "$tmp" || return 1

    jq empty "$tmp" >/dev/null 2>&1 || return 1
    [ "$(db_format_state "$tmp")" = "ok" ] || return 1

    bak="$(backup_path)"
    cp "$REPOS_FILE" "$bak" || return 1
    chmod 600 "$bak" || return 1

    chmod 600 "$tmp"
    mv "$tmp" "$REPOS_FILE" || return 1
    printf '%s' "$bak"
}

repos_all_ids() { jq -r '.repositories | keys[]' "$REPOS_FILE"; }

repos_init() {
    [ -f "$REPOS_FILE" ] || jq -nc --arg v "$SCHEMA_VERSION" \
        '{schema: $v, repositories: {}}' | atomic_write "$REPOS_FILE" 600
}

repos_check() {
    local key="$1"
    jq -e --arg k "$key" '.repositories | has($k)' "$REPOS_FILE" >/dev/null 2>&1
}

repos_check_by_name() {
    local org="$1" name="$2" branch="$3"
    jq -r --arg org "$org" --arg name "$name" --arg branch "$branch" \
        '.repositories | to_entries[] | select(.value.org==$org and .value.name==$name and .value.branch==$branch) | .key' \
        "$REPOS_FILE" | head -n1
}

repos_find_by_location() {
    local path="$1"
    jq -r --arg p "$path" \
        '.repositories | to_entries[] | select(.value.locations[]?.path==$p) | .key' \
        "$REPOS_FILE" | head -n1
}

# repos_load_record <key> -- sets REC_KEY, REC_NAME, REC_ORG, REC_BRANCH, REC_LOCATIONS (array)
repos_load_record() {
    local key="$1" json
    json="$(jq -c --arg k "$key" '.repositories[$k]' "$REPOS_FILE")"
    REC_KEY="$key"
    REC_NAME="$(jq -r '.name' <<< "$json")"
    REC_ORG="$(jq -r '.org' <<< "$json")"
    REC_BRANCH="$(jq -r '.branch' <<< "$json")"
    # empty when absent, so callers can apply their own default rather than
    # seeing the string "null"
    REC_ORIGIN="$(jq -r 'if has("origin") then .origin else "" end' <<< "$json")"
    REC_VISIBILITY="$(jq -r 'if has("visibility") then .visibility else "" end' <<< "$json")"
    REC_FOREIGN="$(jq -r 'if has("foreign") then (.foreign | tostring) else "" end' <<< "$json")"
    mapfile -t REC_LOCATIONS < <(jq -r '.locations[]?.path' <<< "$json")
}

# repos_resolve -- dispatches on TARGET_KIND set by resolve_target; exits 5 if not found
repos_resolve() {
    local key=""
    case "$TARGET_KIND" in
        key)
            repos_check "$TARGET_VALUE" || die "$E_NOTFOUND" "no repo registered for key '$TARGET_VALUE'"
            key="$TARGET_VALUE"
            ;;
        fullname)
            key="$(repos_check_by_name "$REPO_ORG" "$REPO_NAME" "$REPO_BRANCH")"
            [ -n "$key" ] || die "$E_NOTFOUND" "no repo registered for $REPO_ORG/$REPO_NAME/$REPO_BRANCH"
            ;;
        path)
            key="$(repos_find_by_location "$TARGET_VALUE")"
            [ -n "$key" ] || die "$E_NOTFOUND" "no repo registered at location '$TARGET_VALUE'"
            ;;
    esac
    repos_load_record "$key"
}

# repos_add -- insert a record for a repo git-utils is creating.
#
# Always private and never foreign: `repo add` generates the key pair and
# writes the sentinel block itself. The origin is composed here, at creation,
# and stored -- everything downstream reads the stored value rather than
# recomposing it, which is what lets adopted and public repos work at all.
repos_add() {
    local key="$1" org="$2" name="$3" branch="$4" priv="$5" pub="$6" tmp now origin
    now="$(now_iso8601)"
    origin="$(clone_url "$key" "$org" "$name")"
    tmp="$(jq --arg k "$key" --arg name "$name" --arg org "$org" --arg branch "$branch" \
        --arg priv "$priv" --arg pub "$pub" --arg origin "$origin" --arg now "$now" \
        '.repositories[$k] = {name:$name, org:$org, branch:$branch,
                              visibility:"private", foreign:false, origin:$origin,
                              private_key:$priv, public_key:$pub,
                              locations: [], images: [],
                              date_created:$now, date_updated:$now}' \
        "$REPOS_FILE")" || return 1
    printf '%s' "$tmp" | atomic_write "$REPOS_FILE" 600
}

# repos_insert <key> <record_json> -- write a complete record.
#
# repos_add composes the fields for `repo add`; this takes a record built by
# the caller, which is what `folder adopt` needs to write the fields that
# describe an existing repo rather than a freshly created one.
repos_insert() {
    local key="$1" rec="$2" tmp
    tmp="$(jq --arg k "$key" --argjson r "$rec" '.repositories[$k] = $r' "$REPOS_FILE")" || return 1
    printf '%s' "$tmp" | atomic_write "$REPOS_FILE" 600
}

# repos_get_field <key> <field> -- prints the value, or empty when absent.
#
# Deliberately NOT `.repositories[$k][$f] // ""`: jq's // treats `false` as
# empty, so a `foreign: false` field would read back as "" and be
# indistinguishable from a missing one. has() decides presence, so `false`
# comes back as the string "false".
repos_get_field() {
    jq -r --arg k "$1" --arg f "$2" \
        'if (.repositories[$k] | has($f)) then .repositories[$k][$f] else "" end' \
        "$REPOS_FILE"
}

# repos_has_field <key> <field> -- presence test. Use this, never truthiness:
# `foreign: false` and `images: []` are present fields with falsy values.
repos_has_field() {
    jq -e --arg k "$1" --arg f "$2" '.repositories[$k] | has($f)' "$REPOS_FILE" >/dev/null 2>&1
}

# repos_set_fields <key> <json_patch> -- merge a patch into the record and
# stamp date_updated, in one atomic write.
#
# date_updated is only stamped when the patch does not carry its own: the
# backfill sets a missing date_updated to date_created deliberately, and
# overwriting that with "now" would defeat it.
repos_set_fields() {
    local key="$1" patch="$2" tmp
    tmp="$(jq --arg k "$key" --argjson p "$patch" --arg now "$(now_iso8601)" \
        '.repositories[$k] += $p
         | if ($p | has("date_updated")) then .
           else .repositories[$k].date_updated = $now end' \
        "$REPOS_FILE")" || return 1
    printf '%s' "$tmp" | atomic_write "$REPOS_FILE" 600
}

repos_delete() {
    local key="$1" tmp
    tmp="$(jq --arg k "$key" 'del(.repositories[$k])' "$REPOS_FILE")" || return 1
    printf '%s' "$tmp" | atomic_write "$REPOS_FILE" 600
}

repos_locations_list() {
    local key="$1"
    jq -r --arg k "$key" '.repositories[$k].locations[]?.path' "$REPOS_FILE"
}

repos_locations_add() {
    local key="$1" path="$2" tmp
    if ! repos_check "$key"; then
        warn "repo record '$key' no longer exists; location not recorded"
        return 0
    fi
    tmp="$(jq --arg k "$key" --arg p "$path" \
        '.repositories[$k].locations = ((.repositories[$k].locations // []) + [{path:$p}] | unique_by(.path))' \
        "$REPOS_FILE")" || return 1
    printf '%s' "$tmp" | atomic_write "$REPOS_FILE" 600
}

# repos_get_images <key>
# Prints the stored `images` value: the compact JSON array if the field is
# present, or the literal string "null" if absent. The null/array
# distinction lets images_write force exactly one write when migrating a
# legacy record, even if the freshly computed result is [].
repos_get_images() {
    local key="$1"
    jq -c --arg k "$key" \
        'if (.repositories[$k] | has("images")) then .repositories[$k].images else null end' \
        "$REPOS_FILE"
}

repos_set_images() {
    local key="$1" images_json="$2" tmp
    tmp="$(jq --arg k "$key" --argjson imgs "$images_json" \
        '.repositories[$k].images = $imgs' "$REPOS_FILE")" || return 1
    printf '%s' "$tmp" | atomic_write "$REPOS_FILE" 600
}

repos_list() {
    jq -r '.repositories | to_entries[] | [.key, .value.org, .value.name, .value.branch] | @tsv' "$REPOS_FILE"
}

# repos_keys -- records with no private_key (public repos) are skipped rather
# than emitted with a blank first column
repos_keys() {
    jq -r '.repositories | to_entries[]
           | select(.value.private_key != null)
           | [.key, .value.private_key, .value.org, .value.name, .value.branch] | @tsv' "$REPOS_FILE"
}

now_iso8601() { date -u +%Y-%m-%dT%H:%M:%SZ; }

display_url() {
    local org="$1" name="$2" branch="$3"
    printf 'https://github.com/%s/%s/%s' "$org" "$name" "$branch"
}

clone_url() {
    local key="$1" org="$2" name="$3"
    printf 'git@%s.repo:%s/%s.git' "$key" "$org" "$name"
}

# ---------------------------------------------------------------------------
# 10. Images layer -- images_*
# ---------------------------------------------------------------------------

# images_read_file <loc> -- source A; prints one image ref per line
images_read_file() {
    local loc="$1"
    local f="$loc/$IMAGES_FILE_NAME"
    [ -e "$f" ] || return 0
    if [ -d "$f" ]; then
        warn "$f is a directory, ignoring"
        return 0
    fi
    if [ ! -r "$f" ]; then
        warn "$f is not readable, ignoring"
        return 0
    fi
    sed -e 's/\r//g' -e 's/#.*$//' \
        -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
        -e '/^$/d' "$f"
}

# images_is_compose_project <loc> -- true/false via exit status
images_is_compose_project() {
    local loc="$1" f
    for f in "$loc/compose.yml" "$loc/compose.yaml" "$loc/docker-compose.yml" "$loc/docker-compose.yaml"; do
        [ -e "$f" ] && return 0
    done
    return 1
}

# images_compose_config_json <loc>
# Prints `docker compose config --format json`, preferring --profile '*'.
# Verifies the wildcard actually pulled in every declared profile's
# services by comparing against an explicit --profile <name>... run; falls
# back to the explicit list if they differ. Costs one extra `config` call
# only when the compose file declares at least one profile.
images_compose_config_json() {
    local loc="$1"
    local -a declared=()
    mapfile -t declared < <(cd "$loc" && docker compose config --profiles 2>/dev/null)

    local -a profile_args=(--profile "$COMPOSE_PROFILE_WILDCARD")
    if [ "${#declared[@]}" -gt 0 ]; then
        local -a explicit_args=()
        local p
        for p in "${declared[@]}"; do explicit_args+=(--profile "$p"); done

        local wildcard_keys explicit_keys
        wildcard_keys="$(cd "$loc" && docker compose --profile "$COMPOSE_PROFILE_WILDCARD" config --format json 2>/dev/null | jq -rS '.services // {} | keys')"
        explicit_keys="$(cd "$loc" && docker compose "${explicit_args[@]}" config --format json 2>/dev/null | jq -rS '.services // {} | keys')"

        [ "$wildcard_keys" = "$explicit_keys" ] || profile_args=("${explicit_args[@]}")
    fi

    ( cd "$loc" && docker compose "${profile_args[@]}" config --format json )
}

# images_compose_extract <loc> -- source B; prints one image ref per line.
# Returns 2 (and warns) specifically when `config` itself failed, so the
# caller's mapfile naturally yields B=∅ without extra plumbing.
images_compose_extract() {
    local loc="$1" json
    json="$(images_compose_config_json "$loc")" || { warn "docker compose config failed for $loc"; return 2; }
    jq -r '[.services // {} | to_entries[]
            | select(.value.build == null)
            | .value.image // empty
            | select(. != "")] | .[]' <<< "$json"
}

# images_collect <loc>
# Prints a compact, sorted, deduplicated JSON array on stdout and returns 0.
# Returns 1 and prints nothing when the compose contribution is
# indeterminate (compose project, docker compose unavailable) -- caller
# must leave the stored `images` value untouched in that case.
images_collect() {
    local loc="$1"
    local -a a_lines=() b_lines=()
    mapfile -t a_lines < <(images_read_file "$loc")

    if images_is_compose_project "$loc"; then
        if ! compose_available; then
            warn "docker compose not available; leaving images unchanged for $loc"
            return 1
        fi
        mapfile -t b_lines < <(images_compose_extract "$loc")
    fi

    printf '%s\n' "${a_lines[@]}" "${b_lines[@]}" \
        | sed '/^$/d' | sort -u | jq -R . | jq -sc .
}

# images_write <key> <new_json>
# Best-effort: skips the write if unchanged, turns every failure (vanished
# record, lock timeout, unwritable store) into a warning. Never call while
# already holding the store lock -- store_lock_soft reuses fd 9, and the
# two lock kinds are never held concurrently in this script.
images_write() {
    local key="$1" new_json="$2" current_json

    repos_check "$key" || { warn "repo record '$key' no longer exists; images not recorded"; return 0; }

    current_json="$(repos_get_images "$key")"
    [ "$new_json" != "$current_json" ] || return 0

    store_lock_soft || { warn "could not acquire lock to update images for '$key'"; return 0; }

    if ! repos_check "$key"; then
        store_unlock_soft
        warn "repo record '$key' no longer exists; images not recorded"
        return 0
    fi
    if ! repos_set_images "$key" "$new_json"; then
        store_unlock_soft
        warn "failed to write images for '$key'"
        return 0
    fi
    store_unlock_soft
}

# images_update_record <key> <loc>
# Orchestrates collect + write for one location. Silent on the
# indeterminate case beyond images_collect's own warning.
images_update_record() {
    local key="$1" loc="$2" new_json
    new_json="$(images_collect "$loc")" || return 0
    images_write "$key" "$new_json"
}

# ---------------------------------------------------------------------------
# 11. Deadline helpers -- deadline_* / run_bounded
# ---------------------------------------------------------------------------

# A deadline bounds a whole unit of work -- one repo, for `repo status` --
# rather than one call. Every external call inside it runs under `timeout`
# with whatever is left, so the unit finishes on time without any call being
# killed from outside the script.
#
# 0 means unbounded, which is the state for every command that has no
# --timeout. Commands that do have one set it, do their work, and clear it.
DEADLINE=0

deadline_set()   { DEADLINE=$(( $(date +%s) + $1 )); }
deadline_clear() { DEADLINE=0; }

# deadline_remaining -- prints the seconds left, or "-" when unbounded.
#
# Returns 1 when the budget is spent, printing nothing. Callers branch on the
# return value, not on the text, so "no deadline" and "no time left" can never
# be confused -- which is the bug this shape exists to prevent.
deadline_remaining() {
    [ "$DEADLINE" -gt 0 ] || { printf '%s' '-'; return 0; }
    local r=$(( DEADLINE - $(date +%s) ))
    [ "$r" -gt 0 ] || return 1
    printf '%s' "$r"
}

# run_bounded <cmd> [args...] -- run under timeout(1) when a deadline is set.
#
# Returns TIMEOUT_EXIT without running anything when the budget is already
# spent, so "we ran out of time before trying" and "the call timed out" reach
# every caller as the same code. Callers map that to a domain code (10 for
# git, 18 for images); a bare 124 tells a user nothing.
run_bounded() {
    local r
    r="$(deadline_remaining)" || return "$TIMEOUT_EXIT"
    if [ "$r" = "-" ]; then
        "$@"
    else
        timeout "$r" "$@"
    fi
}

# ---------------------------------------------------------------------------
# 12. Docker layer -- docker_* / compose_* / image_*
# ---------------------------------------------------------------------------

# Four distinct probes, because conflating them produces the wrong error.
# Notably a plugin probe is NOT a daemon probe: `docker compose version`
# answers "can we parse compose files" without ever contacting dockerd, which
# is why fix 50-01 could keep working on hosts with no daemon running.
docker_available()  { command -v docker >/dev/null 2>&1; }
compose_available() { docker_available && docker compose version >/dev/null 2>&1; }
buildx_available()  { docker_available && docker buildx version >/dev/null 2>&1; }
docker_daemon_ok()  { run_bounded docker info >/dev/null 2>&1; }

# compose_running <loc> -- is any container of this project up?
#
#   0  yes
#   1  no
#   2  could not determine (daemon down, timeout, unparseable project)
#
# The third code matters: without it "nothing is running" and "we could not
# ask" are the same answer, and a redeploy would report a stopped stack on a
# host whose daemon is simply unreachable. Same convention as
# images_compose_extract's return 2.
compose_running() {
    local loc="$1" out
    out="$(cd "$loc" && run_bounded docker compose ps --status running -q)" || return 2
    [ -n "$out" ]
}

# compose_ps_json <loc> -- `docker compose ps` as a JSON array.
#
# `--format json` emits JSON Lines (one object per line), not an array, so
# this slurps. Verified against docker 28.2.2.
compose_ps_json() {
    local loc="$1" out
    out="$(cd "$loc" && run_bounded docker compose ps --format json)" || return 1
    printf '%s' "$out" | jq -s '.'
}

# --- identifiers ----------------------------------------------------------
#
# Docker exposes two unrelated namespaces and calling both of them "digest"
# is how this gets broken:
#
#   image IDs    .Id / a container's .Image   -> restart_pending
#   repo digests .RepoDigests / buildx        -> pull_available
#
# On a containerd-backed image store the two coincide, so a crossed
# comparison passes every test on such a host and then reports a permanent
# false positive on a host with the classic store, where .Id is the config
# digest. The two pairs are kept apart here so a caller has to reach for the
# wrong one deliberately.

# image_id_local <ref> -- the id of the image this reference resolves to
image_id_local() { run_bounded docker image inspect "$1" --format '{{.Id}}'; }

# container_image_id <container> -- the id of the image it is actually running
container_image_id() { run_bounded docker container inspect "$1" --format '{{.Image}}'; }

# image_ref_repo <ref> -- the repository part, with any tag or digest removed.
#
# The tag is only stripped when the colon is in the LAST path segment: a
# registry port ("localhost:5000/foo") also contains one, and stripping that
# would leave "localhost".
image_ref_repo() {
    local ref="${1%@*}" last
    last="${ref##*/}"
    case "$last" in
        *:*) printf '%s' "${ref%:*}" ;;
        *)   printf '%s' "$ref" ;;
    esac
}

# image_repo_digest <ref> -- the pulled index digest, bare (no name@ prefix).
#
# Selects the RepoDigests entry belonging to THIS reference's repository
# rather than taking .[0]. An image pulled from a mirror carries several:
# public.ecr.aws/docker/library/alpine:3.20 comes back with both
# "alpine@sha256:..." and "public.ecr.aws/docker/library/alpine@sha256:...",
# and .[0] is whichever docker listed first -- not necessarily the one whose
# registry we are about to compare against.
#
# Empty output means no repo digest for this reference: the image was built
# locally, or was only ever tagged. That is not an error.
image_repo_digest() {
    local out repo
    out="$(run_bounded docker image inspect "$1" --format '{{json .RepoDigests}}')" || return 1
    repo="$(image_ref_repo "$1")"
    printf '%s' "$out"         | jq -r --arg repo "$repo" '[.[] | select(startswith($repo + "@"))] | .[0] // empty'         | sed 's/^[^@]*@//'
}

# image_remote_digest <ref> -- the registry's current index digest.
#
# buildx, not `docker manifest inspect`: the latter's per-platform entry is a
# manifest digest and never equals what a pull records locally, so comparing
# the two reports "update available" forever on any multi-arch image.
#
# The plain output, NOT --format. This is a knowing exception to this
# script's rule against parsing human-readable output, and the reason is
# measured rather than assumed: ANY --format makes buildx resolve the whole
# manifest tree -- one registry request per platform, sixteen for alpine --
# while the default output needs only the index. Under registry rate limiting
# the --format forms fail on a child manifest while the plain form still
# answers. `repo status -i` walks every image of every repo, so a 16x request
# amplification is disqualifying.
#
# The exception is narrower than it looks: `Digest:` is an untranslated field
# label, unlike `git status`, whose text is localised and whose phrasing
# changes with the state being described. The shape check below turns a
# future format change into a loud failure rather than a wrong digest.
#
# A failed fetch prints nothing, and the tempting alternative (`imagetools
# inspect --raw | sha256sum`) hashes whatever came back -- error text, or no
# bytes at all -- into a well-formed digest that can never match. Returning 1
# keeps "could not ask" distinct from "asked, and it differs".
image_remote_digest() {
    local out digest
    out="$(run_bounded docker buildx imagetools inspect "$1")" || return 1
    digest="$(printf '%s
' "$out" | awk '/^Digest:/ {print $2; exit}')"
    case "$digest" in
        sha256:*) [ "${#digest}" -eq 71 ] || return 1 ;;
        *) return 1 ;;
    esac
    printf '%s' "$digest"
}

# ---------------------------------------------------------------------------
# 13. Key layer -- keys_*
# ---------------------------------------------------------------------------

keys_check() {
    local key="$1"
    [ -e "$SSH_DIR/${key}.key" ]
}

keys_preflight() {
    [ -w "$SSH_DIR" ] || die "$E_IO" "$SSH_DIR is not writable"
    if [ -e "$SSH_CONFIG" ]; then
        [ -w "$SSH_CONFIG" ] || die "$E_IO" "$SSH_CONFIG is not writable"
    fi
}

keys_add() {
    local key="$1" host content

    mkdir -p "$SSH_DIR"
    chmod 700 "$SSH_DIR"
    [ -e "$SSH_CONFIG" ] || { : > "$SSH_CONFIG"; chmod 600 "$SSH_CONFIG"; }

    host="$(hostname)"
    ssh-keygen -t ed25519 \
        -C "deploy@${host}.${key}" \
        -f "$SSH_DIR/${key}.key" \
        -N '' >/dev/null 2>&1 \
        || die "$E_IO" "failed to generate deploy key for '$key'"
    chmod 600 "$SSH_DIR/${key}.key"

    content="$(block_marker_open "$key")
Host ${key}.repo
    HostName github.com
    AddKeysToAgent yes
    StrictHostKeyChecking no
    PreferredAuthentications publickey
    IdentityFile ${SSH_DIR}/${key}.key

$(block_marker_close "$key")"

    block_upsert "$SSH_CONFIG" "$key" "$content"
    chmod 600 "$SSH_CONFIG"
}

keys_delete() {
    local key="$1"
    rm -f "$SSH_DIR/${key}.key" "$SSH_DIR/${key}.key.pub"
    block_delete "$SSH_CONFIG" "$key"
    [ -f "$SSH_CONFIG" ] && chmod 600 "$SSH_CONFIG"
    return 0
}

# ---------------------------------------------------------------------------
# 14. Adoption layer -- adopt_*
# ---------------------------------------------------------------------------

# adopt_current_branch <loc> -- prints the checked-out branch name.
#
# Fails on a git error OR on empty output. The emptiness check is mandatory,
# not defensive: on a detached HEAD `git branch --show-current` prints nothing
# and exits 0, so an exit-code check alone would let an empty branch into the
# record -- and `repo update` would then run `git reset --hard "origin/"`.
adopt_current_branch() {
    local loc="$1" branch
    branch="$(git -C "$loc" branch --show-current 2>/dev/null)" || return 1
    [ -n "$branch" ] || return 1
    printf '%s\n' "$branch"
}

# adopt_read_origin <loc> -- prints the origin remote URL; fails if absent.
#
# `git config --get remote.origin.url`, NOT `git remote get-url`: the latter
# expands url.<base>.insteadOf rewrites, so on a host that has one configured
# it returns the rewritten target instead of what the repo actually declares.
# The configured value is the right thing to store -- git applies the same
# rewrite again at clone time, whereas a baked-in rewritten URL would be wrong
# anywhere the rewrite is not configured.
adopt_read_origin() {
    local loc="$1" url
    url="$(git -C "$loc" config --get remote.origin.url 2>/dev/null)" || return 1
    [ -n "$url" ] || return 1
    printf '%s\n' "$url"
}

# adopt_parse_origin <url> -- sets ORIGIN_VISIBILITY, ORIGIN_HOST, ORIGIN_ORG,
# ORIGIN_NAME. Returns 1 when the URL is not one of the two supported forms.
#
#   git@<host>:<org>/<name>[.git]        -> private
#   https://<host>/<org>/<name>[.git]    -> public
#
# The check is purely structural; the caller validates the parts against the
# id/org/name charset rules. `.git` is stripped with ${var%.git} rather than an
# optional regex group because bash ERE has no lazy quantifiers, so
# `(.+?)(\.git)?$` cannot be expressed and the greedy form would swallow it.
# shellcheck disable=SC2034  # consumed by cmd_folder_adopt (phase 6)
adopt_parse_origin() {
    local url="$1"
    url="${url%/}"

    if [[ "$url" =~ ^git@([^:]+):([^/]+)/(.+)$ ]]; then
        ORIGIN_VISIBILITY="private"
        ORIGIN_HOST="${BASH_REMATCH[1]}"
        ORIGIN_ORG="${BASH_REMATCH[2]}"
        ORIGIN_NAME="${BASH_REMATCH[3]%.git}"
    elif [[ "$url" =~ ^https://([^/]+)/([^/]+)/(.+)$ ]]; then
        ORIGIN_VISIBILITY="public"
        ORIGIN_HOST="${BASH_REMATCH[1]}"
        ORIGIN_ORG="${BASH_REMATCH[2]}"
        ORIGIN_NAME="${BASH_REMATCH[3]%.git}"
    else
        return 1
    fi

    # A remaining slash means nested groups (GitLab-style org/sub/name), which
    # this record schema cannot represent. Reject here so the caller reports
    # "unparseable origin" rather than a confusing id-validation error later.
    case "$ORIGIN_NAME" in */*) return 1 ;; esac
    [ -n "$ORIGIN_HOST" ] && [ -n "$ORIGIN_ORG" ] && [ -n "$ORIGIN_NAME" ]
}

# adopt_find_identity <host_alias> -- prints the IdentityFile path declared for
# a Host alias in ~/.ssh/config, with a leading ~/ expanded.
#
# Written for hand-maintained config, which is what adoption targets:
#   - keywords are case-insensitive (`host`, `identityfile` are legal)
#   - a Host line may list several aliases and patterns; only an EXACT match
#     counts, so a `Host *` catch-all is never mistaken for this repo's block
#   - the block ends at the next Host/Match line, or EOF
#   - trailing `# comments` are stripped
#
# Not handled (out of scope, per the specification): `Include` directives, and
# the `Keyword=Value` spelling.
adopt_find_identity() {
    local host="$1" path
    [ -f "$SSH_CONFIG" ] || return 1

    path="$(awk -v want="$host" '
        {
            line = $0
            sub(/#.*/, "", line)
            n = split(line, t, /[ \t]+/)
            i = 1
            while (i <= n && t[i] == "") i++
            if (i > n) next

            kw = tolower(t[i])
            if (kw == "host" || kw == "match") {
                inblock = 0
                if (kw == "host") {
                    for (j = i + 1; j <= n; j++) if (t[j] == want) inblock = 1
                }
                next
            }
            if (inblock && kw == "identityfile" && (i + 1) <= n) {
                print t[i + 1]
                exit
            }
        }
    ' "$SSH_CONFIG")"

    [ -n "$path" ] || return 1

    # A literal "~/" read out of the config file -- nothing has expanded it,
    # since it arrived as text. git-utils writes absolute paths itself, so this
    # matters precisely for the hand-written blocks adoption targets.
    if [ "$path" != "${path#\~/}" ]; then
        path="$HOME/${path#\~/}"
    fi
    printf '%s\n' "$path"
}

# adopt_block_exists <repo_id> -- does ~/.ssh/config hold the git-utils
# sentinel block for this id?
#
# This is the shared `foreign` test: that block is written only by `repo add`,
# so its presence proves git-utils created the repo's key material. Both
# `folder adopt` and the `repo validate --fix` backfill call this one function,
# which is what stops the two from ever disagreeing.
adopt_block_exists() {
    [ -f "$SSH_CONFIG" ] || return 1
    grep -qF "$(block_marker_open "$1")" "$SSH_CONFIG"
}

# ---------------------------------------------------------------------------
# 15. Validation layer -- fv_* / rv_* / db_validate
# ---------------------------------------------------------------------------

# The four folder checks. Each prints one status object and nothing else, so
# `folder validate --check-type <name>` is a call to one of them and batch mode
# is a call to all four. Keeping them separate is what makes single-check mode
# honest: the Skip rules live inside the checks, not in the assembler, so
# asking for one check gives the same verdict it would have given in a batch.

# fv_location <loc>
fv_location() {
    if [ -d "$1" ]; then
        status_obj 0 "Ok"
    else
        status_obj "$E_NOTFOUND" "Failed" "Folder does not exist"
    fi
}

# fv_worktree <loc> -- is this a git work tree?
#
# folder_is_git tests `-e .git`, not `-d`: in a linked worktree or a submodule
# `.git` is a FILE pointing at the real git directory. The older `-d` tests in
# repo update/delete are the backlog item this check retires.
fv_worktree() {
    local loc="$1"
    if [ ! -d "$loc" ]; then
        status_obj 0 "Skipped" "Folder does not exist"
    elif folder_is_git "$loc"; then
        status_obj 0 "Ok"
    else
        status_obj "$E_GITFOLDER" "Failed" "Folder is not a git work tree"
    fi
}

# fv_tracking <loc> -- does any record claim this folder?
#
# Deliberately NOT skipped when the folder is missing: a record listing a path
# that no longer exists is exactly the interesting case, and `validate --fix`
# is what prunes it.
fv_tracking() {
    local id
    id="$(repos_find_by_location "$1" || true)"
    if [ -n "$id" ]; then
        status_obj 0 "Ok"
    else
        status_obj "$E_NOTFOUND" "Failed" "Folder is not tracked"
    fi
}

# fv_origin <loc> -- do the folder's remote and branch match its record?
#
# Skipped whenever an earlier check already explains the problem, so one fault
# is never counted twice. Until fix 50-04 this check had to Fail for "exists
# but is not a git repo", because nothing else reported it; `worktree` reports
# it now, so this skips that case too.
fv_origin() {
    local loc="$1" id
    id="$(repos_find_by_location "$loc" || true)"

    if [ ! -d "$loc" ]; then
        status_obj 0 "Skipped" "Folder does not exist"
        return 0
    fi
    if ! folder_is_git "$loc"; then
        status_obj 0 "Skipped" "Folder is not a git work tree"
        return 0
    fi
    if [ -z "$id" ]; then
        status_obj 0 "Skipped" "Folder is not tracked"
        return 0
    fi

    local url branch e_origin e_branch
    url="$(adopt_read_origin "$loc" || true)"
    branch="$(adopt_current_branch "$loc" || true)"
    e_origin="$(repos_get_field "$id" origin)"
    e_branch="$(repos_get_field "$id" branch)"

    if [ -z "$url" ]; then
        status_obj "$E_MISMATCH" "Failed" "Repo has no 'origin' remote"
    elif [ -z "$e_origin" ]; then
        # a record defect, not a folder defect -- repo validate's `fields`
        # check is what reports it, and --fix is what repairs it
        status_obj 0 "Skipped" "Record has no origin to compare"
    elif [ "$url" != "$e_origin" ]; then
        status_obj "$E_MISMATCH" "Failed" "Origin does not match the record"
    elif [ -z "$branch" ]; then
        status_obj "$E_MISMATCH" "Failed" "Cannot determine the current branch"
    elif [ "$branch" != "$e_branch" ]; then
        status_obj "$E_MISMATCH" "Failed" "Branch '$branch' does not match the record's '$e_branch'"
    else
        status_obj 0 "Ok"
    fi
}

# FV_CHECKS -- the check order, which is also the order the exit code is
# resolved in. An array, not a string: IFS has no space in this script.
declare -ra FV_CHECKS=(location worktree tracking origin)

# fv_checks_list -- the check names as one space-separated line.
#
# "${FV_CHECKS[*]}" alone would join them with a NEWLINE: [*] joins on the
# first character of IFS, and this script sets IFS to newline-tab. The two
# error messages below were arriving as four lines each before this existed.
fv_checks_list() { local IFS=' '; printf '%s' "${FV_CHECKS[*]}"; }

# fv_check <name> <loc> -- run exactly one check
fv_check() {
    case "$1" in
        location) fv_location "$2" ;;
        worktree) fv_worktree "$2" ;;
        tracking) fv_tracking "$2" ;;
        origin)   fv_origin   "$2" ;;
        *) die "$E_ARGS" "invalid --check-type: '$1' (expected $(fv_checks_list))" ;;
    esac
}

# fv_run <abs_path> -- prints the folder-validate JSON; returns 1 when any
# check Failed, 0 otherwise.
#
# The command is a thin wrapper around this. Higher levels call it as a shell
# function, never as a subprocess: `repo validate` runs it once per location,
# and re-entering the script would repeat every pre-check and re-read the store
# for each one.
fv_run() {
    local loc="$1" name out rc=0
    local doc="{}"
    for name in "${FV_CHECKS[@]}"; do
        out="$(fv_check "$name" "$loc")"
        doc="$(jq -c --arg k "$name" --argjson v "$out" '. + {($k): $v}' <<< "$doc")"
        if status_failed "$out"; then rc=1; fi
    done
    printf '%s
' "$doc"
    return "$rc"
}

# fv_exit_code <fv_run json> -- the first failed check's own code, in
# FV_CHECKS order, or 0 when nothing failed.
#
# `folder validate` reports the code of the fault rather than a bare 1, so a
# caller can tell "no such folder" (5) from "not a git work tree" (6) without
# parsing the document.
fv_exit_code() {
    jq -r '[.location, .worktree, .tracking, .origin]
           | map(select(.status == "Failed"))
           | if length == 0 then 0 else .[0].code end' <<< "$1"
}

# RV_REQUIRED_FIELDS -- every record must carry these. private_key/public_key
# are added for private repos only.
#
# An array, not a space-separated string: this script runs with IFS=$'\n\t',
# so word-splitting an unquoted string does NOT split on spaces and the whole
# list would be iterated as a single value.
declare -ra RV_REQUIRED_FIELDS=(
    name org branch visibility foreign origin
    locations images date_created date_updated
)

# rv_birth_date <loc> -- best guess at when a checkout came into existence.
#
# `stat -c %W` returns 0 on the many kernel/filesystem combinations that do not
# record a birth time, which is why this falls through to mtime, then to the
# repo's first commit, then to now. A missing timestamp must never abort a
# repair run.
rv_birth_date() {
    local ref="${1:-}" ts="" first=""

    if [ -n "$ref" ] && [ -d "$ref" ]; then
        ts="$(stat -c '%W' "$ref" 2>/dev/null || printf '0')"
        case "$ts" in ''|0|-) ts="$(stat -c '%Y' "$ref" 2>/dev/null || printf '')" ;; esac
        if [ -n "$ts" ] && [ "$ts" != "0" ]; then
            if date -u -d "@$ts" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null; then
                return 0
            fi
        fi
        first="$(git -C "$ref" log --max-parents=0 --format=%aI 2>/dev/null | tail -n1 || printf '')"
        if [ -n "$first" ]; then
            if date -u -d "$first" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null; then
                return 0
            fi
        fi
    fi
    now_iso8601
}

# rv_fix <repo_id> -- prune dead locations and backfill missing fields, in a
# single locked write. Prints the names of what it repaired, comma-separated;
# prints nothing when there was nothing to do.
#
# Pruning comes first so the backfill reads origin and dates from a location
# that actually survives.
rv_fix() {
    local id="$1"
    local -a stored=() alive=()
    local patch="{}" changed="" loc

    mapfile -t stored < <(repos_locations_list "$id")
    for loc in "${stored[@]}"; do
        if [ -d "$loc" ]; then alive+=("$loc"); fi
    done

    _rv_add() {   # _rv_add <field> <jq-arg-type> <value>
        if [ "$2" = "json" ]; then
            patch="$(jq -c --arg f "$1" --argjson v "$3" '. + {($f): $v}' <<< "$patch")"
        else
            patch="$(jq -c --arg f "$1" --arg v "$3" '. + {($f): $v}' <<< "$patch")"
        fi
        if [ -z "$changed" ]; then changed="$1"; else changed="$changed, $1"; fi
    }

    # locations: prune, or create when the field is missing entirely
    if [ "${#alive[@]}" -ne "${#stored[@]}" ]; then
        local locs_json="[]"
        if [ "${#alive[@]}" -gt 0 ]; then
            locs_json="$(printf '%s\n' "${alive[@]}" | jq -R . | jq -sc 'map({path: .})')"
        fi
        _rv_add locations json "$locs_json"
    elif ! repos_has_field "$id" locations; then
        _rv_add locations json "[]"
    fi

    if ! repos_has_field "$id" images; then
        _rv_add images json "[]"
    fi

    local ref=""
    if [ "${#alive[@]}" -gt 0 ]; then ref="${alive[0]}"; fi

    # origin: read it from a surviving checkout, else compose the convention
    local origin_eff
    origin_eff="$(repos_get_field "$id" origin)"
    if ! repos_has_field "$id" origin; then
        local o="" org name
        if [ -n "$ref" ] && folder_is_git "$ref"; then
            o="$(adopt_read_origin "$ref" || printf '')"
        fi
        if [ -z "$o" ]; then
            org="$(repos_get_field "$id" org)"
            name="$(repos_get_field "$id" name)"
            if [ -n "$org" ] && [ -n "$name" ]; then
                o="$(clone_url "$id" "$org" "$name")"
            fi
        fi
        if [ -n "$o" ]; then
            origin_eff="$o"
            _rv_add origin str "$o"
        fi
    fi

    if ! repos_has_field "$id" visibility; then
        local v="private"
        if [ -n "$origin_eff" ] && adopt_parse_origin "$origin_eff"; then
            v="$ORIGIN_VISIBILITY"
        fi
        _rv_add visibility str "$v"
    fi

    # the same sentinel test folder adopt uses, so the two cannot disagree
    if ! repos_has_field "$id" foreign; then
        local fo="true"
        if adopt_block_exists "$id"; then fo="false"; fi
        _rv_add foreign json "$fo"
    fi

    local created_eff
    created_eff="$(repos_get_field "$id" date_created)"
    if ! repos_has_field "$id" date_created; then
        created_eff="$(rv_birth_date "$ref")"
        _rv_add date_created str "$created_eff"
    fi

    if ! repos_has_field "$id" date_updated; then
        local du="$created_eff"
        if [ -z "$du" ]; then du="$(now_iso8601)"; fi
        _rv_add date_updated str "$du"
    fi

    unset -f _rv_add
    [ -n "$changed" ] || return 0

    store_lock
    if ! repos_set_fields "$id" "$patch"; then
        store_unlock
        warn "failed to write repairs for '$id' to $REPOS_FILE"
        return 0
    fi
    store_unlock

    printf '%s' "$changed"
}

# rv_run <repo_id> [<fix>] -- prints the repo-validate JSON; returns health.code.
#
# All validation results are nested under `checks` so they can never collide
# with record fields: `locations` exists in both, as an array in the record and
# as a per-path map of folder-validate results in the checks.
rv_run() {
    local id="$1" fix="${2:-0}"
    local s_fields s_keys s_ssh s_health
    local vis foreign rc=0 fixed=""

    # The repair runs first, so everything below reads the repaired state --
    # repos_get_field, repos_has_field and the final projection all re-read the
    # store, so the emitted record shows the fixed values rather than the ones
    # the run started with.
    if [ "$fix" = "1" ]; then
        fixed="$(rv_fix "$id")"
        # images are re-read only under --fix: it writes the record, and a run
        # without --fix must not mutate the store at all
        local -a fixlocs=()
        mapfile -t fixlocs < <(repos_locations_list "$id")
        if [ "${#fixlocs[@]}" -gt 0 ]; then
            images_update_record "$id" "${fixlocs[0]}"
        fi
    fi

    vis="$(repos_get_field "$id" visibility)"
    foreign="$(repos_get_field "$id" foreign)"

    # --- fields -----------------------------------------------------------
    local missing_str="" f
    for f in "${RV_REQUIRED_FIELDS[@]}"; do
        if ! repos_has_field "$id" "$f"; then
            if [ -z "$missing_str" ]; then missing_str="$f"; else missing_str="$missing_str, $f"; fi
        fi
    done
    if [ "$vis" = "private" ]; then
        for f in private_key public_key; do
            if ! repos_has_field "$id" "$f"; then
                if [ -z "$missing_str" ]; then missing_str="$f"; else missing_str="$missing_str, $f"; fi
            fi
        done
    fi
    # Still-missing fields outrank a partial repair: name, org and branch have
    # nothing to be backfilled from, so a --fix run can legitimately leave the
    # record incomplete and must say so rather than claim "Fixed".
    if [ -n "$missing_str" ]; then
        s_fields="$(status_obj "$E_DBFORMAT" "Failed" "Missing fields: $missing_str")"
    elif [ -n "$fixed" ]; then
        s_fields="$(status_obj 0 "Fixed" "Repaired: $fixed")"
    else
        s_fields="$(status_obj 0 "Ok")"
    fi

    # --- keys -------------------------------------------------------------
    if [ "$vis" != "private" ]; then
        s_keys="$(status_obj 0 "Skipped" "Not a private repo")"
    else
        local priv pub absent=""
        priv="$(repos_get_field "$id" private_key)"
        pub="$(repos_get_field "$id" public_key)"
        if [ -z "$priv" ] || [ ! -f "$priv" ]; then absent="${priv:-<unset>}"; fi
        if [ -z "$pub" ] || [ ! -f "$pub" ]; then
            if [ -z "$absent" ]; then absent="${pub:-<unset>}"; else absent="$absent, ${pub:-<unset>}"; fi
        fi
        if [ -z "$absent" ]; then
            s_keys="$(status_obj 0 "Ok")"
        else
            s_keys="$(status_obj 1 "Failed" "Deploy key files not found: $absent")"
        fi
    fi

    # --- ssh --------------------------------------------------------------
    if [ "$vis" != "private" ]; then
        s_ssh="$(status_obj 0 "Skipped" "Not a private repo")"
    elif [ "$foreign" = "true" ]; then
        s_ssh="$(status_obj 0 "Skipped" "Foreign repo; git-utils does not manage its ssh config")"
    elif adopt_block_exists "$id"; then
        s_ssh="$(status_obj 0 "Ok")"
    else
        s_ssh="$(status_obj 1 "Failed" "Missing sentinel delimited block")"
    fi

    # --- locations --------------------------------------------------------
    local -a locs=()
    mapfile -t locs < <(repos_locations_list "$id")
    local loc_map="{}" loc fvjson loc_failed=0
    for loc in "${locs[@]}"; do
        if fvjson="$(fv_run "$loc")"; then :; else loc_failed=1; fi
        loc_map="$(jq -c --arg p "$loc" --argjson r "$fvjson" '. + {($p): $r}' <<< "$loc_map")"
    done

    # --- health -----------------------------------------------------------
    local failed="$loc_failed" s
    for s in "$s_fields" "$s_keys" "$s_ssh"; do
        if status_failed "$s"; then failed=1; fi
    done

    if [ "$failed" -eq 1 ]; then
        s_health="$(status_obj 1 "Failed")"
        rc=1
    elif [ "${#locs[@]}" -eq 0 ]; then
        s_health="$(status_obj 0 "Warning" "Repository has no locations")"
    else
        s_health="$(status_obj 0 "Ok")"
    fi

    jq -c --arg k "$id" \
        --argjson fields "$s_fields" --argjson keys "$s_keys" --argjson ssh "$s_ssh" \
        --argjson locs "$loc_map" --argjson health "$s_health" \
        '{id: $k} + .repositories[$k]
         + {checks: {fields: $fields, keys: $keys, ssh: $ssh, locations: $locs, health: $health}}' \
        "$REPOS_FILE"

    return "$rc"
}

# db_validate [<fix>] -- prints the whole-store validation JSON; returns 1 if
# anything failed.
#
# Each step stops the run when it fails, because the next one cannot be
# evaluated: there is no schema to check in an unparseable file, and no records
# to walk in a layout that has not been converted.
db_validate() {
    local fix="${1:-0}"
    local s_db s_schema state rc=0

    if [ ! -f "$REPOS_FILE" ]; then
        s_db="$(status_obj "$E_NOTFOUND" "Failed" "Database file not found: $REPOS_FILE")"
        jq -nc --argjson d "$s_db" '{database: $d}'
        return 1
    fi

    state="$(db_format_state)"

    if [ "$state" = "invalid" ]; then
        # no repair path: nothing can be recovered from a file that does not parse
        s_db="$(status_obj "$E_IO" "Failed" "Unable to parse database file")"
        jq -nc --argjson d "$s_db" '{database: $d}'
        return 1
    fi

    if [ "$state" = "old" ]; then
        if [ "$fix" != "1" ]; then
            s_db="$(status_obj "$E_DBFORMAT" "Failed" "Database is in old format")"
            jq -nc --argjson d "$s_db" '{database: $d}'
            return 1
        fi
        local bak
        store_lock
        if ! bak="$(db_convert_with_backup)"; then
            store_unlock
            s_db="$(status_obj "$E_IO" "Failed" "Conversion failed; database left unchanged")"
            jq -nc --argjson d "$s_db" '{database: $d}'
            return 1
        fi
        store_unlock
        s_db="$(status_obj 0 "Fixed" "Converted to schema $SCHEMA_VERSION; backup written to $bak")"
        state="$(db_format_state)"
    else
        s_db="$(status_obj 0 "Ok")"
    fi

    if [ "$state" != "ok" ]; then
        s_schema="$(status_obj 1 "Failed" "Database schema is in invalid format or missing")"
        jq -nc --argjson d "$s_db" --argjson s "$s_schema" '{database: $d, schema: $s}'
        return 1
    fi
    s_schema="$(status_obj 0 "Ok")"

    # Per record. --fix propagates: without it a --fix run would convert the
    # layout and then leave every record missing its new fields.
    #
    # The store lock is NOT held here -- rv_fix takes it per repo, and holding
    # it across this loop would deadlock against itself.
    local -a ids=()
    mapfile -t ids < <(repos_all_ids)
    local reps="[]" id out
    for id in "${ids[@]}"; do
        if out="$(rv_run "$id" "$fix")"; then :; else rc=1; fi
        reps="$(jq -c --argjson r "$out" '. + [$r]' <<< "$reps")"
    done

    jq -nc --argjson d "$s_db" --argjson s "$s_schema" --argjson r "$reps" \
        '{database: $d, schema: $s, repositories: $r}'
    return "$rc"
}

# ---------------------------------------------------------------------------
# 16. Command implementations
# ---------------------------------------------------------------------------

cmd_setup() {
    local opt_org="" opt_branch=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_setup; exit 0 ;;
            -o|--default-org)
                [ $# -ge 2 ] || die "$E_ARGS" "--default-org requires a value"
                opt_org="$2"; shift 2 ;;
            --default-org=*) opt_org="${1#*=}"; shift ;;
            -b|--default-branch)
                [ $# -ge 2 ] || die "$E_ARGS" "--default-branch requires a value"
                opt_branch="$2"; shift 2 ;;
            --default-branch=*) opt_branch="${1#*=}"; shift ;;
            --) shift ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) die "$E_ARGS" "unexpected argument: $1" ;;
        esac
    done

    [ -z "$opt_org" ] || validate_part "$opt_org" 3 "org"
    [ -z "$opt_branch" ] || validate_part "$opt_branch" 1 "branch"

    local sbin=""
    if [ -d /usr/local/sbin ]; then
        sbin=/usr/local/sbin
    elif [ -d /usr/sbin ]; then
        sbin=/usr/sbin
    else
        die "$E_PRECHECK" "neither /usr/local/sbin nor /usr/sbin exists"
    fi

    local SUDO=""
    if [ ! -w "$sbin" ]; then
        command -v sudo >/dev/null 2>&1 || die "$E_PRECHECK" "$sbin is not writable and sudo is not available"
        SUDO="sudo"
    fi

    local self
    self="$(realpath "${BASH_SOURCE[0]}")"

    if [ -e "$sbin/git-utils" ] || [ -L "$sbin/git-utils" ]; then
        local existing
        existing="$(realpath -m "$sbin/git-utils" 2>/dev/null || printf '')"
        if [ "$existing" = "$self" ]; then
            warn "$sbin/git-utils already points here, leaving it"
        else
            warn "$sbin/git-utils already exists and points at '${existing:-?}', not '$self'; leaving it"
        fi
    else
        $SUDO ln -s "$self" "$sbin/git-utils"
    fi

    # Outside the branch above, deliberately. `git reset --hard` restores this
    # script with whatever mode git recorded for it, so an update of the repo
    # can strip the executable bit and every later run fails with "Permission
    # denied". Re-running setup has to be able to repair that on its own --
    # otherwise the only cure is deleting the symlink first, which is not
    # something a user would guess.
    if [ ! -x "$self" ]; then
        $SUDO chmod +x "$self" || die "$E_IO" "cannot make $self executable"
        info "restored the executable bit on $self"
    fi

    local existing_org="" existing_branch=""
    if [ -f "$BASHRC" ]; then
        local block
        block="$(awk -v open="$(block_marker_open "")" -v close_marker="$(block_marker_close "")" \
            '$0==open{f=1;next} $0==close_marker{f=0} f' "$BASHRC")"
        existing_org="$(printf '%s\n' "$block" | sed -n 's/^export GH_DEFAULT_ORG="\(.*\)"$/\1/p')"
        existing_branch="$(printf '%s\n' "$block" | sed -n 's/^export GH_DEFAULT_BRANCH="\(.*\)"$/\1/p')"
    fi

    local final_org="${opt_org:-$existing_org}"
    local final_branch="${opt_branch:-$existing_branch}"

    local path_needed=1
    case ":$PATH:" in
        *":$sbin:"*) path_needed=0 ;;
    esac

    local body=""
    [ "$path_needed" -eq 1 ] && body+="export PATH=\"\$PATH:$sbin\""$'\n'
    [ -n "$final_org" ] && body+="export GH_DEFAULT_ORG=\"$final_org\""$'\n'
    [ -n "$final_branch" ] && body+="export GH_DEFAULT_BRANCH=\"$final_branch\""$'\n'

    local content
    content="$(block_marker_open "")"$'\n'"${body}$(block_marker_close "")"

    block_upsert "$BASHRC" "" "$content"

    [ -n "$final_org" ] && export GH_DEFAULT_ORG="$final_org"
    [ -n "$final_branch" ] && export GH_DEFAULT_BRANCH="$final_branch"

    info "setup complete."
    info "note: already-open shells need 'source ~/.bashrc' to pick up the changes."
}

cmd_repo_add() {
    local name_flag=""
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_repo_add; exit 0 ;;
            -n|--name)
                [ $# -ge 2 ] || die "$E_ARGS" "--name requires a value"
                name_flag="$2"; shift 2 ;;
            --name=*) name_flag="${1#*=}"; shift ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -ge 1 ] || { help_repo_add; exit "$E_ARGS"; }
    [ "${#args[@]}" -le 1 ] || die "$E_ARGS" "unexpected argument: ${args[1]}"
    local repo_arg="${args[0]}"

    require_cmds git realpath jq yq ssh-keygen
    precheck_store_creatable

    parse_repo_name "$repo_arg"
    local key="${name_flag:-$REPO_NAME}"
    validate_part "$key" 3 "key"

    if [ -e "$SSH_DIR" ]; then
        [ -w "$SSH_DIR" ] || die "$E_IO" "$SSH_DIR is not writable"
    else
        mkdir -p "$SSH_DIR" || die "$E_IO" "cannot create $SSH_DIR"
        chmod 700 "$SSH_DIR" || die "$E_IO" "cannot set permissions on $SSH_DIR"
    fi
    if [ -e "$SSH_CONFIG" ]; then
        [ -w "$SSH_CONFIG" ] || die "$E_IO" "$SSH_CONFIG is not writable"
    else
        { : > "$SSH_CONFIG"; } 2>/dev/null || die "$E_IO" "cannot create $SSH_CONFIG"
        chmod 600 "$SSH_CONFIG" || die "$E_IO" "cannot set permissions on $SSH_CONFIG"
    fi
    if [ -e "$REPOS_FILE" ]; then
        [ -w "$REPOS_FILE" ] || die "$E_IO" "$REPOS_FILE is not writable"
    else
        [ -w "$HOME" ] || die "$E_IO" "$HOME is not writable"
    fi

    store_lock
    repos_init
    if repos_check "$key"; then
        store_unlock
        die "$E_EXISTS" "repo key '$key' is already registered"
    fi
    if keys_check "$key"; then
        store_unlock
        die "$E_EXISTS" "deploy key '$key' already exists"
    fi

    keys_add "$key"

    if ! repos_add "$key" "$REPO_ORG" "$REPO_NAME" "$REPO_BRANCH" \
            "$SSH_DIR/${key}.key" "$SSH_DIR/${key}.key.pub"; then
        keys_delete "$key"
        store_unlock
        die "$E_IO" "failed to write $REPOS_FILE; rolled back deploy key"
    fi
    store_unlock

    local host; host="$(hostname)"
    cat << EOF

Add following key to Github deployment keys:

   Key name: ${host}.${key}
   Key value:
   $(cat "$SSH_DIR/${key}.key.pub")

Then use following command to clone github repository:

   git-utils repo clone ${key}

EOF
}

cmd_repo_delete() {
    local force=0 with_folders=0
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_repo_delete; exit 0 ;;
            -f|--force) force=1; shift ;;
            --with-folders) with_folders=1; shift ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -le 1 ] || die "$E_ARGS" "unexpected argument: ${args[1]}"
    local target="${args[0]:-}"
    FORCE="$force"

    precheck_common
    precheck_store

    resolve_repo_target "$target"
    repos_resolve

    # git-utils only removes key material it created. A foreign repo's keys and
    # Host block were written by someone else -- possibly shared with other
    # repos -- and a public repo has none. Absent fields default to the
    # pre-adoption world, where every record was private and git-utils-made.
    local owns_keys=0
    if [ "${REC_VISIBILITY:-private}" = "private" ] && [ "${REC_FOREIGN:-false}" != "true" ]; then
        owns_keys=1
    fi

    # only meaningful when we are actually going to touch ~/.ssh
    if [ "$owns_keys" -eq 1 ]; then
        keys_preflight
    fi

    local loc
    for loc in "${REC_LOCATIONS[@]}"; do
        [ -e "$loc" ] || warn "recorded location no longer exists: $loc"
    done

    local del_key="$REC_KEY"
    local -a del_locations=("${REC_LOCATIONS[@]}")

    if [ "$with_folders" -eq 1 ]; then
        # Guards and confirmation run BEFORE the store is touched, so
        # declining leaves the record intact as well as the folders. With a
        # path target there was one folder at stake and the check could run
        # late; now every location is.
        local l
        for l in "${del_locations[@]}"; do
            case "$l" in
                "/"|"$HOME") die "$E_IO" "refusing to delete $l" ;;
            esac
        done

        # One prompt naming every dirty location, rather than one per folder.
        local -a dirty_locs=()
        for l in "${del_locations[@]}"; do
            folder_is_git "$l" || continue
            if [ -n "$(cd "$l" && git status --porcelain --ignored)" ]; then
                dirty_locs+=("$l")
            fi
        done
        if [ "${#dirty_locs[@]}" -gt 0 ]; then
            local msg
            msg="$(printf 'these folders have untracked or ignored files:\n'
                    printf '  %s\n' "${dirty_locs[@]}"
                    printf 'Delete them anyway?')"
            confirm "$msg" || exit 0
        fi
    fi

    store_lock
    if [ "$owns_keys" -eq 1 ]; then
        keys_delete "$del_key"
    fi
    repos_delete "$del_key"
    store_unlock

    if [ "$with_folders" -eq 1 ]; then
        # Only recorded locations are ever removed -- iterating the record IS
        # the guard the path form needed an explicit check for. A failed rm
        # leaves an untracked folder and exit 3; the reverse order would leave
        # a record pointing at nothing, which looks healthy until read.
        local rc=0 l
        for l in "${del_locations[@]}"; do
            [ -e "$l" ] || continue
            if ! rm -rf "$l"; then
                warn "failed to remove folder; orphaned path: $l"
                rc="$E_IO"
            fi
        done
        if [ "$rc" -ne 0 ]; then
            info "deleted repo '$del_key'"
            exit "$rc"
        fi
    fi

    info "deleted repo '$del_key'"
}

cmd_repo_clone() {
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_repo_clone; exit 0 ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -ge 1 ] || { help_repo_clone; exit "$E_ARGS"; }
    [ "${#args[@]}" -le 2 ] || die "$E_ARGS" "unexpected argument: ${args[2]}"
    local target="${args[0]}" dest="${args[1]:-}"

    precheck_common
    precheck_store

    resolve_repo_target "$target"
    repos_resolve

    local out="${dest:-$REC_NAME}"
    [ ! -e "$out" ] || die "$E_EXISTS" "destination '$out' already exists"

    # The record's own origin, not a recomposed one: a foreign repo clones
    # through its real Host alias and a public one over https, and neither is
    # expressible as git@<id>.repo:<org>/<name>.git.
    local url="$REC_ORIGIN"
    if [ -z "$url" ]; then
        url="$(clone_url "$REC_KEY" "$REC_ORG" "$REC_NAME")"
        warn "record '$REC_KEY' has no origin; falling back to '$url' (run 'git-utils repo validate $REC_KEY --fix')"
    fi

    git clone -b "$REC_BRANCH" "$url" "$out" \
        || die "$E_IO" "git clone failed"

    local abs; abs="$(realpath -m -- "$out")"
    store_lock
    repos_locations_add "$REC_KEY" "$abs"
    store_unlock

    images_update_record "$REC_KEY" "$abs"

    info "cloned into $out"
}

cmd_repo_update() {
    local all=0
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_repo_update; exit 0 ;;
            -a|--all) all=1; shift ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -le 1 ] || die "$E_ARGS" "unexpected argument: ${args[1]}"
    local target="${args[0]:-}"

    precheck_common
    precheck_store

    resolve_repo_target "$target"
    repos_resolve

    local -a targets=()
    if [ "$TARGET_KIND" = "path" ] && [ "$all" -ne 1 ]; then
        targets=("$TARGET_VALUE")
        local loc
        for loc in "${REC_LOCATIONS[@]}"; do
            [ "$loc" = "$TARGET_VALUE" ] || warn "not updating other tracked location: $loc"
        done
    else
        targets=("${REC_LOCATIONS[@]}")
    fi

    local -a failed=() succeeded=()
    local loc
    for loc in "${targets[@]}"; do
        if [ ! -d "$loc" ] || [ ! -d "$loc/.git" ]; then
            warn "skipping missing or non-git location: $loc"
            continue
        fi
        if ( cd "$loc" && git fetch origin && git reset --hard "origin/$REC_BRANCH" && git clean -fd ); then
            succeeded+=("$loc")
        else
            failed+=("$loc")
        fi
    done

    # Image collection happens once per invocation, regardless of --all:
    #   TARGET_KIND=path         -> only that exact path, and only if it succeeded
    #   TARGET_KIND=key|fullname -> first location in REC_LOCATIONS order that succeeded
    local collect_loc="" l
    if [ "$TARGET_KIND" = "path" ]; then
        for l in "${succeeded[@]}"; do
            [ "$l" = "$TARGET_VALUE" ] && collect_loc="$TARGET_VALUE"
        done
    else
        for loc in "${REC_LOCATIONS[@]}"; do
            for l in "${succeeded[@]}"; do
                [ "$l" = "$loc" ] && collect_loc="$loc"
            done
            [ -n "$collect_loc" ] && break
        done
    fi
    [ -z "$collect_loc" ] || images_update_record "$REC_KEY" "$collect_loc"

    if [ "${#failed[@]}" -gt 0 ]; then
        warn "update failed for:"
        for loc in "${failed[@]}"; do
            warn "  $loc"
        done
        exit "$E_IO"
    fi
}

