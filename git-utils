help_main() {
    cat << 'EOF'
git-utils - manage tracked git/GitHub repos and their deploy keys

Usage:
  git-utils setup [-o <org>] [-b <branch>]

  git-utils repo add <org/name[/branch]> [-n <key>]
  git-utils repo clone <repo> [<folder_name>]
  git-utils repo update [<repo_or_path>] [-a]
  git-utils repo delete [<repo_or_path>] [-f]
  git-utils repo list
  git-utils repo keys
  git-utils repo info [<repo_or_path>]
  git-utils repo validate <repo> [--fix]

  git-utils folder status [<path>]
  git-utils folder validate [<path>]
  git-utils folder adopt [<path>] [-n <id>]

  git-utils validate [--fix]

Repo commands take a repo key or a full org/name/branch -- never a path.
Folder commands take a filesystem path. `git-utils folder repo <path>`
bridges the two:

  git-utils repo info "$(git-utils folder repo)"

repo info, repo validate, folder status, folder validate and validate
accept --output-format json|text|yaml|plain (default plain).

`plain` is line-oriented output for pipes. Where a command defines no line
form it is identical to `text`.

Aliases:
  git-utils repos ...   same as 'git-utils repo ...'
  git-utils update ...  same as 'git-utils repo update ...'

There is no 'folders' alias; the folder group is spelled out in full.

Run 'git-utils <command> -h' for command-specific help.
EOF
}

help_repo_info() {
    cat << 'EOF'
git-utils repo info [<repo_key_or_full_name_or_path>]
                    [--output-format json|text|yaml|plain]

Prints one repo record, with its id as the first field. With no argument
the current folder is used.

The argument may be a repo key, a full repo name (org/name/branch), or a
path to a cloned folder — the same three forms 'repo update' and
'repo delete' accept. Exits 5 if nothing matches.
EOF
}

help_validate() {
    cat << 'EOF'
git-utils validate [--fix] [--output-format json|text|yaml|plain]

Checks the whole store: that it parses, that it is in a layout this
script understands, that its schema version is one it knows, and then
every record in turn.

With --fix it also repairs. An old-format store is converted to the
current schema, and --fix carries down into each record, so locations
that no longer exist are pruned and missing fields are backfilled.

The conversion is the one operation that rewrites the whole file, so it
is built and verified before anything irreversible happens, and the
original is copied to a timestamped ~/.repositories.json.<UTC>.bak first.
Backups are never overwritten. A conversion that fails verification
leaves the store untouched and writes no backup at all.

An unparseable store cannot be repaired and is only reported.

Exits 0 when everything checks out, 1 otherwise.
EOF
}

help_repo_validate() {
    cat << 'EOF'
git-utils repo validate <repo_key_or_full_name> [--fix]
                        [--output-format json|text|yaml|plain]

Checks one repo record. Prints the record with a 'checks' object added:

  fields     every field the schema requires is present
  keys       the deploy key pair exists on disk    (private repos)
  ssh        ~/.ssh/config holds its sentinel block (private, non-foreign)
  folder repo       which repo owns a folder
  locations  folder validate run against each recorded location
  health     the overall verdict

Checks that do not apply read 'Skipped'. A healthy record with no
locations reports health 'Warning' and still exits 0.

With --fix it also repairs, in this order: locations pointing at folders
that no longer exist are pruned, then missing fields are backfilled from
whatever survives, then images are re-read. Fields with nothing to infer
them from (name, org, branch) are left alone and still report Failed.
Without --fix nothing is written.

Takes a repo key or a full repo name; for a path use 'folder validate'.
Exits 0 when healthy, 1 when any check failed.
EOF
}

help_folder_validate() {
    cat << 'EOF'
git-utils folder validate [<path>] [-c|--check-type <check>]
                          [--output-format json|text|yaml|plain]

Checks one cloned folder against the store. With no argument the current
folder is used. There is no --fix; nothing is repaired or written.

  location  the folder exists                                    (5)
  worktree  the folder is a git work tree                        (6)
  tracking  the folder is in some record's locations             (5)
  origin    its origin remote and branch match the record        (8)

With --check-type only that one check runs and the output is a single
status object rather than four.

A check reads 'Skipped' when an earlier one already explains the problem,
so a single fault is not reported twice. That holds in single mode too:
--check-type origin on a folder that does not exist is Skipped, not a
manufactured failure.

Exits with the first failed check's own code, in the order above, or 0
when every check passes.
EOF
}

help_folder_adopt() {
    cat << 'EOF'
git-utils folder adopt [<path>] [-n|--name <id>]

Registers an existing local git repo. With no argument the current folder
is used. The repo id defaults to the repo name parsed from the origin;
override it with --name.

The origin must be one of:

  git@<host>:<org>/<name>.git       a private repo, keys looked up in
                                    ~/.ssh/config by the Host alias
  https://<host>/<org>/<name>       a public repo, no keys

Adopt only reads. It never rewrites the repo's remote, its keys, or
~/.ssh/config, and records the repo as 'foreign' unless git-utils' own
sentinel block is still present for that id -- so 'repo delete' will not
remove key material git-utils did not create.

Adopting a folder that is already tracked does nothing. Adopting a second
checkout of an already-tracked repo appends a location.

Exits: 5 no such folder, 6 not a git repo, 8 conflicts with an existing
record, 10 unusable origin or detached HEAD, 3 deploy keys not found.
EOF
}

help_folder_repo() {
    cat << 'EOF'
git-utils folder repo [<path>] [--output-format json|text|yaml|plain]

Prints the id of the repo that owns a folder. With no argument the current
folder is used.

Repo commands take a repo key or full name, never a path, so this is how a
checkout reaches them:

  git-utils repo info "$(git-utils folder repo)"
  git-utils repo validate "$(git-utils folder repo /srv/app)"

Exits 5 when the folder does not exist or no record claims it, 6 when it is
not a git work tree, and 0 otherwise -- including when the folder's origin
disagrees with its record, since the repo is still identifiable.
EOF
}

help_folder_status() {
    cat << 'EOF'
git-utils folder status [<path>] [--output-format json|text|yaml|plain]

Reports whether a folder is a tracked git repo. With no argument the
current folder is used. The argument is always a filesystem path, never
a repo key.

Checks run in order and stop at the first failure:

  code 5  Not Found        the folder does not exist
  code 6  Not Git Folder   the folder is not a git repo
  code 5  Not Tracked      the git repo is not in the store

Exits 0 when the folder is a tracked git repo, 1 otherwise. The status
code above appears in the output, not in the exit code.
EOF
}

help_setup() {
    cat << 'EOF'
git-utils setup [-o|--default-org <org>] [-b|--default-branch <branch>]

Installs git-utils as a symlink in /usr/local/sbin (or /usr/sbin) and
configures GH_DEFAULT_ORG / GH_DEFAULT_BRANCH in ~/.bashrc.

Already-open shells must run 'source ~/.bashrc' to see the changes.
EOF
}

help_repo_add() {
    cat << 'EOF'
git-utils repo add <org/name/branch | org/name | name> [-n|--name <key>]

Registers a repo and generates a GitHub deploy key for it.
If <org> is omitted, GH_DEFAULT_ORG must be set.
If <branch> is omitted, GH_DEFAULT_BRANCH (or 'main') is used.
The registered key defaults to the repo name; override with --name.
EOF
}

help_repo_delete() {
    cat << 'EOF'
git-utils repo delete <repo_key_or_full_name> [-f|--force] [--with-folders]

Removes a tracked repo and its deploy key. The checkouts are left alone
unless --with-folders is given, in which case every recorded location is
removed from disk as well.

A path is not accepted; use: git-utils repo delete "$(git-utils folder repo)"

--with-folders removes ALL of the record's locations, not one. Only
recorded locations are ever touched, / and $HOME are refused outright, and
if any location has untracked or ignored files you are asked once, naming
them -- declining deletes nothing at all, not even the record.

Key material is only removed when git-utils created it. An adopted
(foreign) repo keeps its key pair and its ~/.ssh/config block, and a
public repo has none -- in both cases only the record goes.
EOF
}

help_repo_clone() {
    cat << 'EOF'
git-utils repo clone <repo_key_or_full_name> [<folder_name>]

Clones a tracked repo from the origin recorded for it, which for a repo
added by git-utils goes through its deploy key. Defaults the destination
folder to the repo name.
EOF
}

help_repo_update() {
    cat << 'EOF'
git-utils repo update [<repo_key_or_full_name_or_path>] [-a|--all]

Fetches and hard-resets a tracked repo to its remote branch. With no
argument, the current folder is used. With a path and without --all,
only that location is updated; --all updates every tracked location.
EOF
}

help_repo_list() {
    cat << 'EOF'
git-utils repo list

Lists each registered repo key with its display URL.
EOF
}

help_repo_keys() {
    cat << 'EOF'
git-utils repo keys

Lists each registered repo's deploy key file path with its display URL.
EOF
}

# ---------------------------------------------------------------------------
# 18. Argument router
# ---------------------------------------------------------------------------

main() {
    local cmd="${1:-}"
    case "$cmd" in
        "")
            help_main
            exit "$E_ARGS"
            ;;
        -h|--help)
            help_main
            exit 0
            ;;
        setup)
            shift
            cmd_setup "$@"
            ;;
        repo|repos)
            shift
            local sub="${1:-}"
            case "$sub" in
                "")
                    help_main
                    exit "$E_ARGS"
                    ;;
                -h|--help)
                    help_main
                    exit 0
                    ;;
                add) shift; cmd_repo_add "$@" ;;
                delete) shift; cmd_repo_delete "$@" ;;
                clone) shift; cmd_repo_clone "$@" ;;
                update) shift; cmd_repo_update "$@" ;;
                list) shift; cmd_repo_list "$@" ;;
                keys) shift; cmd_repo_keys "$@" ;;
                info) shift; cmd_repo_info "$@" ;;
                validate) shift; cmd_repo_validate "$@" ;;
                *)
                    help_main
                    exit "$E_ARGS"
                    ;;
            esac
            ;;
        folder)
            # deliberately no 'folders' alias -- the folder group is spelled out
            shift
            local fsub="${1:-}"
            case "$fsub" in
                "")
                    help_main
                    exit "$E_ARGS"
                    ;;
                -h|--help)
                    help_main
                    exit 0
                    ;;
                repo|repository) shift; cmd_folder_repo "$@" ;;
                status) shift; cmd_folder_status "$@" ;;
                adopt) shift; cmd_folder_adopt "$@" ;;
                validate) shift; cmd_folder_validate "$@" ;;
                *)
                    help_main
                    exit "$E_ARGS"
                    ;;
            esac
            ;;
        validate)
            shift
            cmd_validate "$@"
            ;;
        update)
            shift
            cmd_repo_update "$@"
            ;;
        *)
            help_main
            exit "$E_ARGS"
            ;;
    esac
}

main "$@"
