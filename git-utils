cmd_setup() {
    local opt_org="" opt_branch=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_setup; exit 0 ;;
            -o|--default-org)
                [ $# -ge 2 ] || die "$E_ARGS" "--default-org requires a value"
                opt_org="$2"; shift 2 ;;
            --default-org=*) opt_org="${1#*=}"; shift ;;
            -b|--default-branch)
                [ $# -ge 2 ] || die "$E_ARGS" "--default-branch requires a value"
                opt_branch="$2"; shift 2 ;;
            --default-branch=*) opt_branch="${1#*=}"; shift ;;
            --) shift ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) die "$E_ARGS" "unexpected argument: $1" ;;
        esac
    done

    [ -z "$opt_org" ] || validate_part "$opt_org" 3 "org"
    [ -z "$opt_branch" ] || validate_part "$opt_branch" 1 "branch"

    local sbin=""
    if [ -d /usr/local/sbin ]; then
        sbin=/usr/local/sbin
    elif [ -d /usr/sbin ]; then
        sbin=/usr/sbin
    else
        die "$E_PRECHECK" "neither /usr/local/sbin nor /usr/sbin exists"
    fi

    local SUDO=""
    if [ ! -w "$sbin" ]; then
        command -v sudo >/dev/null 2>&1 || die "$E_PRECHECK" "$sbin is not writable and sudo is not available"
        SUDO="sudo"
    fi

    local self
    self="$(realpath "${BASH_SOURCE[0]}")"

    if [ -e "$sbin/git-utils" ] || [ -L "$sbin/git-utils" ]; then
        local existing
        existing="$(realpath -m "$sbin/git-utils" 2>/dev/null || printf '')"
        if [ "$existing" = "$self" ]; then
            warn "$sbin/git-utils already points here, leaving it"
        else
            warn "$sbin/git-utils already exists and points at '${existing:-?}', not '$self'; leaving it"
        fi
    else
        $SUDO ln -s "$self" "$sbin/git-utils"
    fi

    # Outside the branch above, deliberately. `git reset --hard` restores this
    # script with whatever mode git recorded for it, so an update of the repo
    # can strip the executable bit and every later run fails with "Permission
    # denied". Re-running setup has to be able to repair that on its own --
    # otherwise the only cure is deleting the symlink first, which is not
    # something a user would guess.
    if [ ! -x "$self" ]; then
        $SUDO chmod +x "$self" || die "$E_IO" "cannot make $self executable"
        info "restored the executable bit on $self"
    fi

    local existing_org="" existing_branch=""
    if [ -f "$BASHRC" ]; then
        local block
        block="$(awk -v open="$(block_marker_open "")" -v close_marker="$(block_marker_close "")" \
            '$0==open{f=1;next} $0==close_marker{f=0} f' "$BASHRC")"
        existing_org="$(printf '%s\n' "$block" | sed -n 's/^export GH_DEFAULT_ORG="\(.*\)"$/\1/p')"
        existing_branch="$(printf '%s\n' "$block" | sed -n 's/^export GH_DEFAULT_BRANCH="\(.*\)"$/\1/p')"
    fi

    local final_org="${opt_org:-$existing_org}"
    local final_branch="${opt_branch:-$existing_branch}"

    local path_needed=1
    case ":$PATH:" in
        *":$sbin:"*) path_needed=0 ;;
    esac

    local body=""
    [ "$path_needed" -eq 1 ] && body+="export PATH=\"\$PATH:$sbin\""$'\n'
    [ -n "$final_org" ] && body+="export GH_DEFAULT_ORG=\"$final_org\""$'\n'
    [ -n "$final_branch" ] && body+="export GH_DEFAULT_BRANCH=\"$final_branch\""$'\n'

    local content
    content="$(block_marker_open "")"$'\n'"${body}$(block_marker_close "")"

    block_upsert "$BASHRC" "" "$content"

    [ -n "$final_org" ] && export GH_DEFAULT_ORG="$final_org"
    [ -n "$final_branch" ] && export GH_DEFAULT_BRANCH="$final_branch"

    info "setup complete."
    info "note: already-open shells need 'source ~/.bashrc' to pick up the changes."
}

cmd_repo_add() {
    local name_flag=""
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_repo_add; exit 0 ;;
            -n|--name)
                [ $# -ge 2 ] || die "$E_ARGS" "--name requires a value"
                name_flag="$2"; shift 2 ;;
            --name=*) name_flag="${1#*=}"; shift ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -ge 1 ] || { help_repo_add; exit "$E_ARGS"; }
    [ "${#args[@]}" -le 1 ] || die "$E_ARGS" "unexpected argument: ${args[1]}"
    local repo_arg="${args[0]}"

    require_cmds git realpath jq yq ssh-keygen
    precheck_store_creatable

    parse_repo_name "$repo_arg"
    local key="${name_flag:-$REPO_NAME}"
    validate_part "$key" 3 "key"

    if [ -e "$SSH_DIR" ]; then
        [ -w "$SSH_DIR" ] || die "$E_IO" "$SSH_DIR is not writable"
    else
        mkdir -p "$SSH_DIR" || die "$E_IO" "cannot create $SSH_DIR"
        chmod 700 "$SSH_DIR" || die "$E_IO" "cannot set permissions on $SSH_DIR"
    fi
    if [ -e "$SSH_CONFIG" ]; then
        [ -w "$SSH_CONFIG" ] || die "$E_IO" "$SSH_CONFIG is not writable"
    else
        { : > "$SSH_CONFIG"; } 2>/dev/null || die "$E_IO" "cannot create $SSH_CONFIG"
        chmod 600 "$SSH_CONFIG" || die "$E_IO" "cannot set permissions on $SSH_CONFIG"
    fi
    if [ -e "$REPOS_FILE" ]; then
        [ -w "$REPOS_FILE" ] || die "$E_IO" "$REPOS_FILE is not writable"
    else
        [ -w "$HOME" ] || die "$E_IO" "$HOME is not writable"
    fi

    store_lock
    repos_init
    if repos_check "$key"; then
        store_unlock
        die "$E_EXISTS" "repo key '$key' is already registered"
    fi
    if keys_check "$key"; then
        store_unlock
        die "$E_EXISTS" "deploy key '$key' already exists"
    fi

    keys_add "$key"

    if ! repos_add "$key" "$REPO_ORG" "$REPO_NAME" "$REPO_BRANCH" \
            "$SSH_DIR/${key}.key" "$SSH_DIR/${key}.key.pub"; then
        keys_delete "$key"
        store_unlock
        die "$E_IO" "failed to write $REPOS_FILE; rolled back deploy key"
    fi
    store_unlock

    local host; host="$(hostname)"
    cat << EOF

Add following key to Github deployment keys:

   Key name: ${host}.${key}
   Key value:
   $(cat "$SSH_DIR/${key}.key.pub")

Then use following command to clone github repository:

   git-utils repo clone ${key}

EOF
}

cmd_repo_delete() {
    local force=0
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_repo_delete; exit 0 ;;
            -f|--force) force=1; shift ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -le 1 ] || die "$E_ARGS" "unexpected argument: ${args[1]}"
    local target="${args[0]:-}"
    FORCE="$force"

    precheck_common
    precheck_store

    resolve_target "$target"
    repos_resolve

    # git-utils only removes key material it created. A foreign repo's keys and
    # Host block were written by someone else -- possibly shared with other
    # repos -- and a public repo has none. Absent fields default to the
    # pre-adoption world, where every record was private and git-utils-made.
    local owns_keys=0
    if [ "${REC_VISIBILITY:-private}" = "private" ] && [ "${REC_FOREIGN:-false}" != "true" ]; then
        owns_keys=1
    fi

    # only meaningful when we are actually going to touch ~/.ssh
    if [ "$owns_keys" -eq 1 ]; then
        keys_preflight
    fi

    local loc
    for loc in "${REC_LOCATIONS[@]}"; do
        [ "$TARGET_KIND" = "path" ] && [ "$loc" = "$TARGET_VALUE" ] && continue
        [ -e "$loc" ] || warn "recorded location no longer exists: $loc"
    done

    if [ "$TARGET_KIND" = "path" ] && [ -d "$TARGET_VALUE/.git" ]; then
        local dirty
        dirty="$(cd "$TARGET_VALUE" && git status --porcelain --ignored)"
        if [ -n "$dirty" ]; then
            confirm "'$TARGET_VALUE' has untracked/ignored files. Delete anyway?" || exit 0
        fi
    fi

    local del_key="$REC_KEY"
    local -a del_locations=("${REC_LOCATIONS[@]}")

    store_lock
    if [ "$owns_keys" -eq 1 ]; then
        keys_delete "$del_key"
    fi
    repos_delete "$del_key"
    store_unlock

    if [ "$TARGET_KIND" = "path" ]; then
        case "$TARGET_VALUE" in
            "/"|"$HOME") die "$E_IO" "refusing to delete $TARGET_VALUE" ;;
        esac
        local recorded_match=0 rl
        for rl in "${del_locations[@]}"; do
            [ "$rl" = "$TARGET_VALUE" ] && recorded_match=1
        done
        [ "$recorded_match" -eq 1 ] || die "$E_IO" "refusing to delete '$TARGET_VALUE': not a recorded location"

        if ! rm -rf "$TARGET_VALUE"; then
            warn "failed to remove folder; orphaned path: $TARGET_VALUE"
            exit "$E_IO"
        fi
    fi

    info "deleted repo '$del_key'"
}

cmd_repo_clone() {
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_repo_clone; exit 0 ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -ge 1 ] || { help_repo_clone; exit "$E_ARGS"; }
    [ "${#args[@]}" -le 2 ] || die "$E_ARGS" "unexpected argument: ${args[2]}"
    local target="${args[0]}" dest="${args[1]:-}"

    precheck_common
    precheck_store

    resolve_target "$target"
    [ "$TARGET_KIND" != "path" ] || die "$E_ARGS" "repo clone requires a repo key or full repo name, not a path"

    repos_resolve

    local out="${dest:-$REC_NAME}"
    [ ! -e "$out" ] || die "$E_EXISTS" "destination '$out' already exists"

    # The record's own origin, not a recomposed one: a foreign repo clones
    # through its real Host alias and a public one over https, and neither is
    # expressible as git@<id>.repo:<org>/<name>.git.
    local url="$REC_ORIGIN"
    if [ -z "$url" ]; then
        url="$(clone_url "$REC_KEY" "$REC_ORG" "$REC_NAME")"
        warn "record '$REC_KEY' has no origin; falling back to '$url' (run 'git-utils repo validate $REC_KEY --fix')"
    fi

    git clone -b "$REC_BRANCH" "$url" "$out" \
        || die "$E_IO" "git clone failed"

    local abs; abs="$(realpath -m -- "$out")"
    store_lock
    repos_locations_add "$REC_KEY" "$abs"
    store_unlock

    images_update_record "$REC_KEY" "$abs"

    info "cloned into $out"
}

cmd_repo_update() {
    local all=0
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_repo_update; exit 0 ;;
            -a|--all) all=1; shift ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -le 1 ] || die "$E_ARGS" "unexpected argument: ${args[1]}"
    local target="${args[0]:-}"

    precheck_common
    precheck_store

    resolve_target "$target"
    repos_resolve

    local -a targets=()
    if [ "$TARGET_KIND" = "path" ] && [ "$all" -ne 1 ]; then
        targets=("$TARGET_VALUE")
        local loc
        for loc in "${REC_LOCATIONS[@]}"; do
            [ "$loc" = "$TARGET_VALUE" ] || warn "not updating other tracked location: $loc"
        done
    else
        targets=("${REC_LOCATIONS[@]}")
    fi

    local -a failed=() succeeded=()
    local loc
    for loc in "${targets[@]}"; do
        if [ ! -d "$loc" ] || [ ! -d "$loc/.git" ]; then
            warn "skipping missing or non-git location: $loc"
            continue
        fi
        if ( cd "$loc" && git fetch origin && git reset --hard "origin/$REC_BRANCH" && git clean -fd ); then
            succeeded+=("$loc")
        else
            failed+=("$loc")
        fi
    done

    # Image collection happens once per invocation, regardless of --all:
    #   TARGET_KIND=path         -> only that exact path, and only if it succeeded
    #   TARGET_KIND=key|fullname -> first location in REC_LOCATIONS order that succeeded
    local collect_loc="" l
    if [ "$TARGET_KIND" = "path" ]; then
        for l in "${succeeded[@]}"; do
            [ "$l" = "$TARGET_VALUE" ] && collect_loc="$TARGET_VALUE"
        done
    else
        for loc in "${REC_LOCATIONS[@]}"; do
            for l in "${succeeded[@]}"; do
                [ "$l" = "$loc" ] && collect_loc="$loc"
            done
            [ -n "$collect_loc" ] && break
        done
    fi
    [ -z "$collect_loc" ] || images_update_record "$REC_KEY" "$collect_loc"

    if [ "${#failed[@]}" -gt 0 ]; then
        warn "update failed for:"
        for loc in "${failed[@]}"; do
            warn "  $loc"
        done
        exit "$E_IO"
    fi
}

