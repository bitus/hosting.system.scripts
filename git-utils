# folder_is_git <path> -- is this folder a git repo root?
#
# `-e` rather than `-d`: a linked worktree or submodule has .git as a *file*.
# (The older `-d "$loc/.git"` tests in repo update/delete predate this and are
# left alone here; unifying them is a separate cleanup.)
folder_is_git() { [ -e "$1/.git" ]; }

# folder_resolve [<arg>] -- folder commands are filesystem-addressed, so a
# bare token is a relative path, never a repo key. -m: the path is allowed
# not to exist, since "Not Found" is one of the answers.
folder_resolve() { realpath -m -- "${1:-$PWD}"; }

# cmd_folder_repo -- which repo owns this folder?
#
# The bridge between the two address spaces. `repo` commands stopped taking
# paths in fix 50-04, so this is what a caller standing in a checkout pipes
# into them.
cmd_folder_repo() {
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_folder_repo; exit 0 ;;
            --output-format)
                [ $# -ge 2 ] || die "$E_ARGS" "--output-format requires a value"
                output_format_set "$2"; shift 2 ;;
            --output-format=*) output_format_set "${1#*=}"; shift ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -le 1 ] || die "$E_ARGS" "unexpected argument: ${args[1]}"

    precheck_common
    precheck_store

    local loc out rc
    loc="$(folder_resolve "${args[0]:-}")"
    out="$(fv_run "$loc")" || true
    rc="$(fv_exit_code "$out")"

    # 5 and 6 are the codes that mean there is no repo to name: the folder is
    # missing, is not a work tree, or no record claims it. An origin mismatch
    # (8) still resolves -- the record is identifiable, it merely disagrees,
    # and `repo validate` is exactly where a caller would pipe it next.
    case "$rc" in
        5|6) exit "$rc" ;;
    esac

    local id
    id="$(repos_find_by_location "$loc")"
    render_output "$(jq -nc --arg id "$id" '{id: $id}')" "$PLAIN_ID"
}

cmd_folder_status() {
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_folder_status; exit 0 ;;
            --output-format)
                [ $# -ge 2 ] || die "$E_ARGS" "--output-format requires a value"
                output_format_set "$2"; shift 2 ;;
            --output-format=*) output_format_set "${1#*=}"; shift ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -le 1 ] || die "$E_ARGS" "unexpected argument: ${args[1]}"

    precheck_common
    precheck_store

    local path status code=0
    path="$(folder_resolve "${args[0]:-}")"

    # ordered, first failure wins
    if [ ! -d "$path" ]; then
        status="$(status_obj "$E_NOTFOUND" "Not Found" "Folder doesnt exist")"
        code=1
    elif ! folder_is_git "$path"; then
        status="$(status_obj "$E_GITFOLDER" "Not Git Folder" "Folder is not a git repo")"
        code=1
    elif [ -z "$(repos_find_by_location "$path")" ]; then
        status="$(status_obj "$E_NOTFOUND" "Not Tracked" "Git repo is not tracked")"
        code=1
    else
        status="$(status_obj 0 "Ok")"
    fi

    render_output "$(jq -nc --argjson s "$status" '{status: $s}')"
    exit "$code"
}

cmd_validate() {
    local args=()
