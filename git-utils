# fv_check_type_set <value> -- validate and assign, for the flag loop
fv_check_type_set() {
    local c
    for c in "${FV_CHECKS[@]}"; do
        if [ "$1" = "$c" ]; then CHECK_TYPE="$1"; return 0; fi
    done
    die "$E_ARGS" "invalid --check-type: '$1' (expected $(fv_checks_list))"
}

cmd_folder_validate() {
    local args=()
    local CHECK_TYPE=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_folder_validate; exit 0 ;;
            -c|--check-type)
                [ $# -ge 2 ] || die "$E_ARGS" "--check-type requires a value"
                fv_check_type_set "$2"; shift 2 ;;
            --check-type=*) fv_check_type_set "${1#*=}"; shift ;;
            --output-format)
                [ $# -ge 2 ] || die "$E_ARGS" "--output-format requires a value"
                output_format_set "$2"; shift 2 ;;
            --output-format=*) output_format_set "${1#*=}"; shift ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -le 1 ] || die "$E_ARGS" "unexpected argument: ${args[1]}"

    precheck_common
    precheck_store

    local loc out rc
    loc="$(folder_resolve "${args[0]:-}")"

    if [ -n "$CHECK_TYPE" ]; then
        # single mode: one bare status object, and its own code as the exit
        out="$(fv_check "$CHECK_TYPE" "$loc")"
        rc="$(jq -r 'if .status == "Failed" then .code else 0 end' <<< "$out")"
    else
        out="$(fv_run "$loc")" || true
        rc="$(fv_exit_code "$out")"
    fi

    render_output "$out"
    exit "$rc"
}

cmd_folder_adopt() {
    local name_flag=""
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) help_folder_adopt; exit 0 ;;
            -n|--name)
                [ $# -ge 2 ] || die "$E_ARGS" "--name requires a value"
                name_flag="$2"; shift 2 ;;
            --name=*) name_flag="${1#*=}"; shift ;;
            --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
            -*) die "$E_ARGS" "unknown flag: $1" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [ "${#args[@]}" -le 1 ] || die "$E_ARGS" "unexpected argument: ${args[1]}"

    precheck_common
    # adopt creates the store when it is the first thing the user runs
    precheck_store_creatable

    local loc
    loc="$(folder_resolve "${args[0]:-}")"
    [ -d "$loc" ] || die "$E_NOTFOUND" "folder does not exist: $loc"
    folder_is_git "$loc" || die "$E_GITFOLDER" "not a git repo: $loc"

    local branch url
    branch="$(adopt_current_branch "$loc")" \
        || die "$E_CMDOUTPUT" "cannot determine the current branch of '$loc' (detached HEAD?)"
    url="$(adopt_read_origin "$loc")" \
        || die "$E_CMDOUTPUT" "cannot read the 'origin' remote of '$loc'"
    adopt_parse_origin "$url" \
        || die "$E_CMDOUTPUT" "unsupported origin URL: '$url'"

    # Only the id is validated. org, name and branch are recorded as they are:
    # adoption describes a repo that already exists, so rejecting, say, a
    # two-character org or a branch containing '/' would refuse to track real
    # repos over rules that exist to constrain what `repo add` *creates*.
    local repo_id="${name_flag:-$ORIGIN_NAME}"
    validate_part "$repo_id" 3 "id"

    store_lock
    repos_init

    # Is this exact folder already tracked?
    local tracked_id
    tracked_id="$(repos_find_by_location "$loc")"
    if [ -n "$tracked_id" ]; then
        if [ "$tracked_id" = "$repo_id" ]; then
            store_unlock
            info "already tracked as '$repo_id': $loc"
            exit 0
        fi
        store_unlock
        die "$E_MISMATCH" "'$loc' is already tracked under a different id: '$tracked_id'"
    fi

    # Does a record with this id already exist? If it describes the same repo,
    # this is just another checkout of it.
    #
    # Both of these run BEFORE key discovery: appending a location needs no
    # keys, so requiring them here would fail adoptions for no reason.
    if repos_check "$repo_id"; then
        local e_origin e_org e_name e_branch
        e_origin="$(repos_get_field "$repo_id" origin)"
        e_org="$(repos_get_field "$repo_id" org)"
        e_name="$(repos_get_field "$repo_id" name)"
        e_branch="$(repos_get_field "$repo_id" branch)"
        if [ "$e_origin" = "$url" ] && [ "$e_org" = "$ORIGIN_ORG" ] \
           && [ "$e_name" = "$ORIGIN_NAME" ] && [ "$e_branch" = "$branch" ]; then
            if ! repos_locations_add "$repo_id" "$loc"; then
                store_unlock
                die "$E_IO" "failed to write $REPOS_FILE"
            fi
            store_unlock
            info "added location to '$repo_id': $loc"
            exit 0
        fi
        store_unlock
        die "$E_MISMATCH" "repo id '$repo_id' already describes a different repo"
    fi

    # New record. Private repos need their key pair located first.
    local priv="" pub=""
    if [ "$ORIGIN_VISIBILITY" = "private" ]; then
        if ! priv="$(adopt_find_identity "$ORIGIN_HOST")"; then
            store_unlock
            die "$E_IO" "no IdentityFile for Host '$ORIGIN_HOST' in $SSH_CONFIG"
        fi
        pub="${priv}.pub"
        if [ ! -f "$priv" ] || [ ! -f "$pub" ]; then
            store_unlock
            die "$E_IO" "deploy key pair not found: $priv and $pub"
        fi
    fi

    # The shared foreign test: false only when repo add's own sentinel block is
    # still present, which means git-utils created this repo's key material and
    # merely lost the record.
    local foreign="true"
    if adopt_block_exists "$repo_id"; then
        foreign="false"
    fi

    local now rec
    now="$(now_iso8601)"
    rec="$(jq -nc \
        --arg name "$ORIGIN_NAME" --arg org "$ORIGIN_ORG" --arg branch "$branch" \
        --arg vis "$ORIGIN_VISIBILITY" --argjson foreign "$foreign" --arg origin "$url" \
        --arg priv "$priv" --arg pub "$pub" --arg loc "$loc" --arg now "$now" \
        '{name:$name, org:$org, branch:$branch, visibility:$vis, foreign:$foreign, origin:$origin}
         + (if $priv == "" then {} else {private_key:$priv, public_key:$pub} end)
         + {locations: [{path:$loc}], images: [], date_created:$now, date_updated:$now}')"

    if ! repos_insert "$repo_id" "$rec"; then
        store_unlock
        die "$E_IO" "failed to write $REPOS_FILE"
    fi
    store_unlock

    images_update_record "$repo_id" "$loc"

    info "adopted '$repo_id' ($ORIGIN_VISIBILITY, foreign=$foreign) at $loc"
}

