tz -> hdd -> docker -> ntp -> network. A failing task does not stop the
sequence; the exit code is that of the first failure.

      --dry-run          validate everything and print the plan, change nothing
  -f, --force            permit destructive hdd operations (reformat, unmount).
                         Deliberately a flag, not a document field: a config
                         file on its own can never destroy data.
EOF
}

help_setup() {
    cat << 'EOF'
system-setup setup

Installs system-setup as a symlink in /usr/local/sbin (or /usr/sbin), adds
that folder to PATH in ~/.bashrc, and sources command-shortcuts from there.

Already-open shells must run 'source ~/.bashrc' to see the change.
EOF
}

# ---------------------------------------------------------------------------
# 12. Argument router
# ---------------------------------------------------------------------------

main() {
    ORIG_ARGS=("$@")

    # --verbose is global and may appear anywhere; strip it before dispatch.
    local a
    local -a argv=()
    for a in ${1+"$@"}; do
        if [ "$a" = "--verbose" ]; then
            VERBOSE=1
        else
            argv+=("$a")
        fi
    done
    set -- ${argv[@]+"${argv[@]}"}

    # -h/--help wins over everything, including a piped document.
    case "${1:-}" in
        -h|--help) help_main; exit "$E_OK" ;;
    esac

    # A document piped in with no COMMAND is file mode. Any leading flags are
    # handed to cmd_file, so `cat doc | system-setup --force` works - only
    # --verbose is stripped globally above, and gating solely on `$# -eq 0`
    # would send every other flag down the unknown-command path.
    local piped=0
    if [ ! -t 0 ]; then
        if [ $# -eq 0 ]; then
            piped=1
        else
            case "$1" in -*) piped=1 ;; esac
        fi
    fi
    if [ "$piped" -eq 1 ]; then
        cmd_file - ${1+"$@"}
        return 0
    fi

    if [ $# -eq 0 ]; then
        help_main
        exit "$E_ARGS"
    fi

    case "$1" in
        ip|network) shift; cmd_ip ${1+"$@"} ;;
        hdd)        shift; cmd_hdd ${1+"$@"} ;;
        docker)     shift; cmd_docker ${1+"$@"} ;;
        ntp)        shift; cmd_ntp ${1+"$@"} ;;
        tz)         shift; cmd_tz ${1+"$@"} ;;
        file)       shift; cmd_file ${1+"$@"} ;;
        setup)      shift; cmd_setup ${1+"$@"} ;;
        *)
            # A single argument that is an existing file means file mode.
            # Known command names are matched above, so they always win.
            if [ $# -eq 1 ] && [ -f "$1" ]; then
                cmd_file "$1"
            else
                printf 'error: unknown command: %s\n' "$1" >&2
                help_main >&2
                exit "$E_ARGS"
            fi
            ;;
    esac
}

# Only run when executed, not when sourced. Sourcing lets the test suite call
# the validation and resolution functions directly, which is why this script
# ships with no debug subcommands of its own.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main ${1+"$@"}
fi
