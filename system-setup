help_main() {
    cat << 'EOF'
system-setup - basic configuration for freshly deployed Debian 12 VMs

Usage:
  system-setup ip <ip[/mask]> -n <fqdn> [-m <mask>] [-g <gw>] [-d <dns>]... [--no-ipv6] [--no-restart]
  system-setup hdd [-d <device>] [-m <mount>] [-t <ext4|xfs|vfat|ntfs>] [-f]
  system-setup docker [-n <cidr> [-s <bits>]] | -u
  system-setup ntp [-s <server>]... | -u
  system-setup tz <zone>
  system-setup file <path|-> [--dry-run] [-f]
  system-setup setup

Aliases:
  system-setup network ...   same as 'system-setup ip ...'
  system-setup <path>        same as 'system-setup file <path>'
  <document> | system-setup  reads a JSON or YAML document from stdin

Global:
  --verbose                  detailed per-action logging

Run 'system-setup <command> -h' for command-specific help.
EOF
}

help_ip() {
    cat << 'EOF'
system-setup ip <ip[/mask]> -n <fqdn> [-m <mask>] [-g <gw>] [-d <dns>]... [--no-ipv6] [--no-restart]

Alias: system-setup network

Configures the static address, gateway, DNS and hostname of ens192.

  <ip[/mask]>            host address, required; may carry a /bits suffix
  -n, --hostname <fqdn>  host name including the domain, required
  -m, --mask <mask>      24 or 255.255.255.0; overrides the /bits suffix; default 24
  -g, --gateway <ip>     default: host IP with the last octet set to 254
  -d, --dns <ip>         repeatable; default: the gateway
      --no-ipv6          disable IPv6 persistently via /etc/sysctl.d
